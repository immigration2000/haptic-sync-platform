<section class="container" style="max-width:720px;padding-bottom:60px;">
    <div class="section-eyebrow">FEED</div>
    <h1 class="section-title" style="margin-bottom:4px;">피드</h1>
    <p class="text-dim" style="margin:0 0 20px;font-size:13px;">스트리머의 소식과 미리보기 클립. 마음에 들면 전체 영상으로 이어집니다.</p>

    <% if (error) { %><div class="flash-error mb-4"><%= error %></div><% } %>
    <% if (ok) { %><div class="flash-error mb-4" style="background:rgba(0,220,130,.1);border-color:rgba(0,220,130,.3);color:#5EFFB0;">✓ <%= ok %></div><% } %>

    <% if (canPost) { %>
    <div class="card card-body mb-5" style="border-color:rgba(255,45,94,.25);">
        <div class="panel-title">새 포스트</div>
        <form method="POST" action="/feed">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <textarea name="body" rows="3" maxlength="500" required placeholder="소식이나 홍보 문구를 적어주세요"
                      style="width:100%;background:var(--bg-2);border:1px solid var(--border-soft);border-radius:8px;color:white;padding:10px;font-size:14px;resize:vertical;"></textarea>

            <div class="mt-3" style="background:var(--bg-2);border-radius:8px;padding:12px;">
                <div class="text-faint" style="font-size:11px;margin-bottom:8px;">
                    미리보기 클립 — 영상의 <strong>구간만 지정</strong>합니다 (새 파일이 만들어지지 않습니다)
                </div>
                <select name="video_ref" id="clip-src" class="form-select" style="margin-bottom:10px;">
                    <option value="">— 연결 안 함 —</option>
                    <% if (myVideos && myVideos.length) { %>
                        <optgroup label="내 영상">
                            <% myVideos.forEach(function (v) { %>
                                <option value="bj:<%= v.id %>" data-src="<%= v.video_path %>"><%= v.title %></option>
                            <% }) %>
                        </optgroup>
                    <% } %>
                    <% if (siteVideos && siteVideos.length) { %>
                        <optgroup label="사이트 콘텐츠">
                            <% siteVideos.forEach(function (c) { %>
                                <option value="content:<%= c.id %>" data-src="<%= c.video_path %>">[<%= c.type.toUpperCase() %>] <%= c.title %></option>
                            <% }) %>
                        </optgroup>
                    <% } %>
                </select>

                <div id="clip-editor" style="display:none;">
                    <video id="clip-preview" muted playsinline preload="metadata"
                           style="width:100%;aspect-ratio:16/9;background:#000;border-radius:8px;"></video>
                    <div style="margin-top:8px;">
                        <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--tx-2);">
                            <span>시작 <b id="cs-label">0:00</b></span>
                            <span>길이 <b id="cd-label">30</b>초</span>
                        </div>
                        <input id="cs-range" type="range" min="0" max="100" value="0" step="1" style="width:100%;accent-color:var(--c-pink);">
                        <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--tx-2);margin-top:4px;">
                            <span>클립 길이 (최대 60초)</span>
                        </div>
                        <input id="cd-range" type="range" min="5" max="60" value="30" step="1" style="width:100%;accent-color:var(--c-purple);">
                        <button type="button" id="clip-play" class="btn btn-ghost btn-sm mt-2">▶ 이 구간 미리듣기</button>
                    </div>
                </div>
                <input type="hidden" name="clip_start" id="clip-start" value="0">
                <input type="hidden" name="clip_end"   id="clip-end"   value="30">
            </div>

            <div class="flex gap-3 mt-3" style="align-items:center;">
                <button class="btn btn-primary btn-sm">게시</button>
                <span class="text-faint" style="font-size:11px;">외부 링크·연락처(카톡·텔레그램 등)는 등록할 수 없습니다.</span>
            </div>
        </form>
    </div>
    <% } %>

    <% if (allTags && allTags.length) { %>
    <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:18px;align-items:center;">
        <span class="text-faint" style="font-size:11px;">태그</span>
        <a href="/feed" class="cf-tag <%= activeTags.length ? '' : 'on' %>"
           style="font-size:11px;padding:4px 10px;border-radius:999px;border:1px solid var(--border-soft);<%= activeTags.length ? 'color:var(--tx-2);' : 'background:rgba(255,45,94,.14);border-color:var(--border-accent);color:var(--c-pink);' %>">전체</a>
        <% allTags.forEach(function (t) {
             var on = activeTags.indexOf(t.name) >= 0;
             var next = on ? activeTags.filter(function(x){return x!==t.name;}) : activeTags.concat([t.name]);
             var href = next.length ? '/feed?tag=' + encodeURIComponent(next.join(',')) : '/feed';
        %>
            <a href="<%= href %>" style="font-size:11px;padding:4px 10px;border-radius:999px;border:1px solid <%= on ? 'var(--border-accent)' : 'var(--border-soft)' %>;<%= on ? 'background:rgba(255,45,94,.14);color:var(--c-pink);' : 'color:var(--tx-2);' %>"><%= t.name %></a>
        <% }) %>
    </div>
    <% } %>

    <% if (!items.length) { %>
        <div class="text-center text-faint" style="padding:70px 0;">
            <%= activeTags.length ? '이 태그의 게시물이 없습니다.' : '아직 게시물이 없습니다.' %>
            <% if (activeTags.length) { %><br><a href="/feed" style="color:var(--c-pink);">필터 초기화</a><% } %>
        </div>
    <% } %>

    <% items.forEach(function (p) { %>
    <article class="card card-body mb-4">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
            <div style="width:38px;height:38px;border-radius:50%;background:var(--gradient-main);display:flex;align-items:center;justify-content:center;font-weight:700;">
                <%= (p.stage_name || p.nickname || '?').charAt(0) %>
            </div>
            <div style="flex:1;">
                <div style="font-weight:700;font-size:14px;"><%= p.stage_name || p.nickname %></div>
                <div class="text-faint" style="font-size:11px;"><%= String(p.created_at).slice(5, 16) %></div>
            </div>
            <% if (user && (user.id === p.author_id || user.role === 'admin')) { %>
                <form method="POST" action="/feed/<%= p.id %>/delete" style="margin:0;" onsubmit="return confirm('삭제할까요?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="text-faint" style="background:none;border:none;cursor:pointer;font-size:16px;">×</button>
                </form>
            <% } %>
        </div>

        <p style="font-size:14px;line-height:1.6;margin:0 0 10px;white-space:pre-wrap;"><%= p.body %></p>

        <% if (p.video && p.clip_end > p.clip_start) { %>
            <div style="border-radius:10px;overflow:hidden;background:#000;position:relative;">
                <video class="feed-clip" src="<%= p.video.src %>" muted playsinline loop preload="metadata"
                       data-start="<%= p.clip_start %>" data-end="<%= p.clip_end %>"
                       style="width:100%;aspect-ratio:16/9;object-fit:contain;background:#000;"></video>
                <span style="position:absolute;top:8px;left:8px;background:rgba(0,0,0,.7);color:#fff;font-size:10px;padding:3px 8px;border-radius:5px;">
                    ▶ 미리보기 <%= p.clip_end - p.clip_start %>초
                </span>
            </div>
            <a href="<%= p.video.href %>" class="btn btn-primary btn-sm btn-block mt-3">
                <%= p.video.locked ? '🔒 전체 영상 보기 (구독/구매)' : '전체 영상 보기' %> — <%= p.video.title %>
            </a>
        <% } else if (p.video) { %>
            <a href="<%= p.video.href %>" class="btn btn-secondary btn-sm btn-block">🎬 <%= p.video.title %></a>
        <% } %>

        <div style="display:flex;gap:14px;align-items:center;margin-top:12px;padding-top:10px;border-top:1px solid var(--border-soft);">
            <button class="like-btn" data-id="<%= p.id %>" data-liked="<%= p.likedByMe ? '1' : '0' %>"
                    style="background:none;border:none;cursor:pointer;font-size:13px;color:<%= p.likedByMe ? 'var(--c-pink)' : 'var(--tx-3)' %>;">
                ♥ <span class="like-count"><%= p.like_count %></span>
            </button>
            <span class="text-faint" style="font-size:13px;">💬 <%= p.comment_count %></span>
            <% (p.authorTags || []).forEach(function (t) { %>
                <a href="/feed?tag=<%= encodeURIComponent(t) %>" class="tag" style="font-size:10px;"><%= t %></a>
            <% }) %>
            <% if (!user || user.id !== p.author_id) { %>
                <button class="report-btn text-faint" data-id="<%= p.id %>" title="신고"
                        style="margin-left:auto;background:none;border:none;cursor:pointer;font-size:11px;">🚩 신고</button>
            <% } %>
        </div>

        <% if (p.comments && p.comments.length) { %>
            <div style="margin-top:10px;">
                <% p.comments.forEach(function (c) { %>
                    <div style="font-size:12px;margin-bottom:5px;">
                        <span style="color:var(--c-pink);font-weight:600;"><%= c.nickname %></span>
                        <span class="text-dim"><%= c.body %></span>
                    </div>
                <% }) %>
            </div>
        <% } %>

        <form method="POST" action="/feed/<%= p.id %>/comment" style="display:flex;gap:6px;margin-top:10px;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input name="body" maxlength="200" required placeholder="댓글 달기…"
                   style="flex:1;background:var(--bg-2);border:1px solid var(--border-soft);border-radius:6px;color:white;padding:7px 10px;font-size:12px;">
            <button class="btn btn-secondary btn-sm">등록</button>
        </form>
    </article>
    <% }) %>
</section>

<script>
// 클립 = 원본 영상의 구간 재생. 화면에 보일 때만 재생하고 end에 닿으면 start로 되감는다.
document.querySelectorAll('.feed-clip').forEach(function (v) {
    var s = parseFloat(v.dataset.start) || 0, e = parseFloat(v.dataset.end) || 0;
    v.addEventListener('loadedmetadata', function () { try { v.currentTime = s; } catch (_) {} });
    v.addEventListener('timeupdate', function () { if (e && v.currentTime >= e) v.currentTime = s; });
    v.addEventListener('click', function () { v.muted = !v.muted; });
});
if ('IntersectionObserver' in window) {
    var io2 = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
            if (en.isIntersecting) en.target.play().catch(function () {});
            else en.target.pause();
        });
    }, { threshold: 0.5 });
    document.querySelectorAll('.feed-clip').forEach(function (v) { io2.observe(v); });
}

/* 클립 구간 편집 — 슬라이더로 시작점·길이를 잡고 그 구간만 미리듣기 */
(function () {
    var sel = document.getElementById('clip-src');
    if (!sel) return;
    var box = document.getElementById('clip-editor');
    var vid = document.getElementById('clip-preview');
    var cs = document.getElementById('cs-range'), cd = document.getElementById('cd-range');
    var csL = document.getElementById('cs-label'), cdL = document.getElementById('cd-label');
    var hStart = document.getElementById('clip-start'), hEnd = document.getElementById('clip-end');
    var dur = 0, timer = null;

    function fmt(s) { s = Math.floor(s || 0); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); }
    function sync() {
        var start = parseInt(cs.value, 10) || 0;
        var len   = parseInt(cd.value, 10) || 30;
        if (dur && start + len > dur) start = Math.max(0, Math.floor(dur - len));
        csL.textContent = fmt(start);
        cdL.textContent = len;
        hStart.value = start;
        hEnd.value = start + len;
    }
    cs.addEventListener('input', sync);
    cd.addEventListener('input', sync);

    sel.addEventListener('change', function () {
        var opt = sel.options[sel.selectedIndex];
        var src = opt && opt.getAttribute('data-src');
        if (!src) { box.style.display = 'none'; hStart.value = 0; hEnd.value = 0; return; }
        box.style.display = 'block';
        vid.src = src;
        vid.addEventListener('loadedmetadata', function once() {
            vid.removeEventListener('loadedmetadata', once);
            dur = vid.duration || 0;
            cs.max = Math.max(0, Math.floor(dur) - 5);
            sync();
            try { vid.currentTime = parseInt(hStart.value, 10) || 0; } catch (_) {}
        });
    });

    document.getElementById('clip-play').addEventListener('click', function () {
        var s = parseInt(hStart.value, 10) || 0, e = parseInt(hEnd.value, 10) || 30;
        clearInterval(timer);
        try { vid.currentTime = s; } catch (_) {}
        vid.play().catch(function () {});
        timer = setInterval(function () {
            if (vid.currentTime >= e) { vid.pause(); clearInterval(timer); }
        }, 200);
    });
})();

/* 신고 */
document.querySelectorAll('.report-btn').forEach(function (b) {
    b.addEventListener('click', async function () {
        var reason = prompt('신고 사유를 선택하세요:\n1) 스팸  2) 불법  3) 욕설/괴롭힘  4) 미성년 관련  5) 기타\n번호 입력:');
        if (!reason) return;
        var map = { '1': 'spam', '2': 'illegal', '3': 'abuse', '4': 'underage', '5': 'other' };
        var code = map[String(reason).trim()] || 'other';
        var r = await fetch('/feed/' + b.dataset.id + '/report', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': (document.querySelector('meta[name=csrf-token]') || {}).content || '' },
            body: JSON.stringify({ kind: 'post', reason: code }),
        });
        var j = await r.json();
        alert(j.ok ? '신고가 접수되었습니다. 관리자가 확인합니다.' : '신고 실패');
    });
});

document.querySelectorAll('.like-btn').forEach(function (b) {
    b.addEventListener('click', async function () {
        var r = await fetch('/feed/' + b.dataset.id + '/like', {
            method: 'POST',
            headers: { 'x-csrf-token': (document.querySelector('meta[name=csrf-token]') || {}).content || '' },
        });
        var j = await r.json();
        if (!j.ok) return;
        b.querySelector('.like-count').textContent = j.count;
        b.style.color = j.liked ? 'var(--c-pink)' : 'var(--tx-3)';
    });
});
</script>
