<%# 기기 진단 창 — 실기기 테스트용 개발자 화면 (2026-11-19)
    · 이 창에서 직접 기기를 붙여 쓸 수도 있고,
    · 다른 탭(플레이어·통화 등)에서 일어나는 입출력을 BroadcastChannel 로 받아 구경만 할 수도 있다.
    ⚠ 새 창은 별도 자바스크립트 컨텍스트라 **기기 연결 자체는 공유되지 않는다**(브라우저 제약). %>
<section class="container" style="max-width:1100px;">
    <div class="flex items-center gap-3 mb-3" style="justify-content:space-between; flex-wrap:wrap;">
        <h1 class="page-title" style="margin:0;">🔬 기기 진단</h1>
        <span class="text-faint mono" style="font-size:11px;">입력·출력·생략·거부·오류를 한 줄기로 표시</span>
    </div>

    <!-- 상태 -->
    <div class="flex gap-3 mb-4" style="flex-wrap:wrap;">
        <div class="card card-body" style="flex:1; min-width:280px;">
            <div class="panel-title">출력 기기 (브라우저 → 기기)</div>
            <div class="mono" style="font-size:12px; display:grid; grid-template-columns:70px 1fr; gap:4px 10px;">
                <span class="text-faint">상태</span><span id="o-state">미연결</span>
                <span class="text-faint">기기</span><span id="o-label">—</span>
                <span class="text-faint">송신요청</span><span id="o-sent">0</span>
                <span class="text-faint">쓰기완료</span><span id="o-ok">0</span>
                <span class="text-faint">쓰기실패</span><span id="o-fail">0</span>
                <span class="text-faint">쓰기대기</span><span id="o-q">0</span>
                <span class="text-faint">응답</span><span id="o-info">—</span>
                <span class="text-faint">오류</span><span id="o-err">—</span>
            </div>
            <div class="flex gap-2 mt-3" style="flex-wrap:wrap;">
                <button id="b-ble" class="btn btn-secondary btn-sm">📡 BLE 연결</button>
                <button id="b-usb" class="btn btn-secondary btn-sm">🔌 USB 연결</button>
                <button id="b-out-dc" class="btn btn-ghost btn-sm">해제</button>
            </div>
        </div>

        <div class="card card-body" style="flex:1; min-width:280px;">
            <div class="panel-title">입력 기기 (기기 → 브라우저)</div>
            <div class="mono" style="font-size:12px; display:grid; grid-template-columns:70px 1fr; gap:4px 10px;">
                <span class="text-faint">상태</span><span id="i-state">미연결</span>
                <span class="text-faint">기기</span><span id="i-label">—</span>
                <span class="text-faint">수신</span><span id="i-rx">0</span>
                <span class="text-faint">생략</span><span id="i-drop">0</span>
                <span class="text-faint">마지막</span><span id="i-last">—</span>
            </div>
            <div class="flex gap-2 mt-3" style="flex-wrap:wrap; align-items:center;">
                <button id="b-in" class="btn btn-secondary btn-sm">📡 입력 연결</button>
                <button id="b-in-dc" class="btn btn-ghost btn-sm">해제</button>
                <label style="font-size:12px; cursor:pointer;">
                    <input type="checkbox" id="b-relay" checked> 출력으로 복사
                </label>
            </div>
        </div>

        <div class="card card-body" style="flex:1; min-width:300px;">
            <div class="panel-title">타이밍 (최근 300건)</div>
            <div class="mono" style="font-size:12px; display:grid; grid-template-columns:46px 1fr 1fr 1fr; gap:4px 8px;">
                <span></span><span class="text-faint">Hz</span><span class="text-faint">평균</span><span class="text-faint">최대 / p95</span>
                <span class="text-faint">수신</span><span id="t-rx-hz">—</span><span id="t-rx-avg">—</span><span id="t-rx-max">—</span>
                <span class="text-faint">전송</span><span id="t-rl-hz">—</span><span id="t-rl-avg">—</span><span id="t-rl-max">—</span>
                <span class="text-faint">쓰기</span><span class="text-faint">—</span><span id="t-w-avg">—</span><span id="t-w-max">—</span>
            </div>
            <div class="text-faint mt-3" style="font-size:11px; line-height:1.5;">
                <b>수신</b> 기기가 보내는 주기 · <b>전송</b> 실제로 출력에 나간 주기 ·
                <b>쓰기</b> 한 건이 끝나는 데 걸린 시간(ms).<br>
                쓰기 시간이 전송 주기의 <b>한계</b>입니다 — 수신 Hz 가 이것보다 빠르면 생략이 나는 게 정상입니다.
                <span id="t-pend"></span>
            </div>
        </div>
    </div>

    <!-- 축 위치 -->
    <style>
        .ax-track { position:relative; height:13px; border-radius:7px; background:rgba(255,255,255,.07); }
        .ax-fill  { position:absolute; left:0; top:0; bottom:0; width:0; border-radius:7px; transition:none; }
        .ax-fill.rx { background:rgba(56,189,248,.5); }
        .ax-fill.tx { background:rgba(74,222,128,.5); }
        .ax-tick  { position:absolute; top:-3px; width:2px; height:19px; margin-left:-1px; left:0;
                    background:rgba(255,255,255,.75); }
        .ax-row   { display:flex; align-items:center; gap:8px; margin-bottom:4px; }
        .ax-lbl   { width:26px; font-size:11px; }
        .ax-num   { width:52px; text-align:right; font-size:11px; }
    </style>
    <div class="card card-body mb-4">
        <div class="flex" style="justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:6px;">
            <div class="panel-title" style="margin:0;">축 위치 — 수신 vs 송신</div>
            <div class="text-faint mono" style="font-size:11px;" id="ax-lag">수신→복사 지연 —</div>
        </div>
        <div id="ax-list" class="mono" style="font-size:12px; margin-top:10px;">
            <div class="text-faint" id="ax-empty" style="font-size:12px; padding:6px 0;">
                아직 축 명령이 없습니다. 기기를 연결하거나 아래에서 <code>L050I500</code> 를 보내 보세요.
            </div>
        </div>
        <div class="text-faint mt-3" style="font-size:11px; line-height:1.6;">
            막대 = <b>지금 있어야 할 위치</b>(보간 <code>I</code> 반영) · 흰 눈금 = 마지막으로 받은/보낸 <b>목표값</b>.
            아래 곡선은 최근 5초 —
            <span style="color:#38bdf8">수신</span> 과 <span style="color:#4ade80">송신</span> 이 겹쳐 보이면 그대로 전달된 것이고,
            벌어지거나 계단처럼 끊기면 그 구간이 유실·지연입니다.<br>
            ⚠ 이건 <b>우리가 받고 보낸 값</b>입니다. 기기가 실제로 이 곡선대로 움직였는지는 별개 —
            둘을 눈으로 맞춰 보라고 만든 화면입니다. 곡선은 매끄러운데 기기가 덜컥거리면 문제는 기기 쪽입니다.
        </div>
    </div>

    <!-- 수동 전송 -->
    <div class="card card-body mb-4">
        <div class="flex gap-2" style="flex-wrap:wrap; align-items:center;">
            <input id="m-cmd" class="form-input mono" style="flex:1; min-width:220px; font-size:12px;"
                   placeholder="L050I500  (출력 기기로 직접 전송)" value="L050I500">
            <button id="b-send" class="btn btn-primary btn-sm">전송</button>
            <button id="b-send-remote" class="btn btn-secondary btn-sm" title="원격 검증기를 거쳐 전송 — 거부되는지 확인용">검증 거쳐 전송</button>
            <span class="text-faint" style="font-size:11px;">※ '검증 거쳐 전송'은 원격(통화·방송) 경로와 같은 규칙입니다</span>
        </div>
    </div>

    <!-- 로그 -->
    <div class="card card-body">
        <div class="flex items-center gap-2 mb-3" style="justify-content:space-between; flex-wrap:wrap;">
            <div class="flex gap-2" style="flex-wrap:wrap;" id="filters">
                <label class="mono" style="font-size:11px;"><input type="checkbox" data-f="in" checked> 수신</label>
                <label class="mono" style="font-size:11px;"><input type="checkbox" data-f="out" checked> 송신</label>
                <label class="mono" style="font-size:11px;"><input type="checkbox" data-f="relay" checked> 복사</label>
                <label class="mono" style="font-size:11px;"><input type="checkbox" data-f="drop" checked> 생략</label>
                <label class="mono" style="font-size:11px;"><input type="checkbox" data-f="reject" checked> 거부</label>
                <label class="mono" style="font-size:11px;"><input type="checkbox" data-f="err" checked> 오류</label>
                <label class="mono" style="font-size:11px;"><input type="checkbox" data-f="info" checked> 정보</label>
            </div>
            <div class="flex gap-2">
                <button id="b-pause" class="btn btn-ghost btn-sm">⏸ 멈춤</button>
                <button id="b-clear" class="btn btn-ghost btn-sm">지우기</button>
                <button id="b-copy" class="btn btn-secondary btn-sm">복사</button>
                <button id="b-save" class="btn btn-secondary btn-sm">파일로 저장</button>
            </div>
        </div>
        <div id="log" class="mono" style="height:min(52vh,520px); overflow:auto; background:#000;
             border-radius:8px; padding:10px; font-size:11.5px; line-height:1.65;"></div>
        <p class="text-faint mt-2" style="font-size:11px;">
            다른 탭(플레이어·통화 등)에서 일어나는 입출력도 여기로 들어옵니다 —
            <strong>이 창을 연 시점 이후</strong>의 것만 보입니다.
            기기 연결 자체는 탭마다 따로입니다(브라우저 제약).
        </p>
    </div>
</section>

<script>
(function () {
    var D = window.PulseDevice;
    var $ = function (id) { return document.getElementById(id); };
    var logEl = $('log');
    var paused = false, rows = [];
    var MAX_ROWS = 800;

    var COLOR = {
        in:     '#5EFFB0',   // 기기 → 브라우저
        out:    '#7DB7FF',   // 브라우저 → 기기
        relay:  '#B395FF',   // 입력에서 복사되어 나간 것
        drop:   '#FFC46B',   // 보내지 않고 버린 것
        reject: '#FF6B8A',   // 검증에서 거부
        err:    '#FF4B4B',
        info:   '#8A8A99',
    };
    var LABEL = { in:'수신', out:'송신', relay:'복사', drop:'생략', reject:'거부', err:'오류', info:'정보' };

    function shown(dir) {
        var cb = document.querySelector('#filters input[data-f="' + dir + '"]');
        return !cb || cb.checked;
    }
    function hhmmss(ts) {
        var d = new Date(ts);
        return ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)+':'+('0'+d.getSeconds()).slice(-2)
             + '.' + ('00'+d.getMilliseconds()).slice(-3);
    }
    function addRow(ev, fromOther) {
        rows.push(ev);
        if (rows.length > MAX_ROWS) rows.shift();
        feedAxis(ev);                      // ⚠ 멈춤 위에 둔다 — 로그를 멈춰도 막대는 현재 상태를 보여야 한다
        if (paused) return;
        render(ev, fromOther);
        while (logEl.children.length > MAX_ROWS) logEl.removeChild(logEl.firstChild);
    }
    function render(ev, fromOther) {
        if (!shown(ev.dir)) return;
        var atBottom = logEl.scrollTop + logEl.clientHeight >= logEl.scrollHeight - 30;
        var line = document.createElement('div');
        var c = COLOR[ev.dir] || '#ccc';
        // textContent 로만 넣는다 — 기기에서 온 문자열을 그대로 HTML 로 두면 안 된다
        var t = document.createElement('span'); t.style.color = '#55555f'; t.textContent = hhmmss(ev.ts) + ' ';
        var k = document.createElement('span'); k.style.color = c; k.style.fontWeight = '700';
        k.textContent = (LABEL[ev.dir] || ev.dir).padEnd(3, ' ') + ' ';
        var b = document.createElement('span'); b.style.color = c; b.textContent = ev.text;
        var m = document.createElement('span'); m.style.color = '#6b6b78';
        m.textContent = (ev.meta ? '   // ' + ev.meta : '') + (fromOther ? '   [다른 탭]' : '');
        line.appendChild(t); line.appendChild(k); line.appendChild(b); line.appendChild(m);
        logEl.appendChild(line);
        if (atBottom) logEl.scrollTop = logEl.scrollHeight;
    }
    function redraw() {
        logEl.textContent = '';
        rows.forEach(function (ev) { render(ev, ev._other); });
    }

    // ── 이 창에서 일어나는 일 ──
    if (D && D.onLog) {
        D.getLog().forEach(function (ev) { rows.push(ev); feedAxis(ev); });
        redraw();
        D.onLog(function (ev) { addRow(ev, false); });
    }
    // ── 다른 탭에서 일어나는 일 ──
    // ⚠ device.js 는 **구독자가 있다고 알려올 때만** 내보낸다. 아무도 안 보는데 초당 수백 건을
    //   뿌리면 그 자체가 메인 스레드를 먹어 릴레이가 끊겼다(2026-11-20). 그래서 이 창이
    //   2초마다 "보고 있다"고 알린다 — 창을 닫으면 6초 안에 발행이 저절로 멈춘다.
    try {
        if ('BroadcastChannel' in window) {
            var ch = new BroadcastChannel('pulse_devlog');
            ch.onmessage = function (e) {
                var m = e.data; if (!m) return;
                if (m.watch === 1) return;                       // 다른 진단 창의 구독 알림
                var list = m.batch || [m];                       // 묶음 / 옛 단건 형식 모두 받는다
                for (var k = 0; k < list.length; k++) {
                    var ev = list[k];
                    if (!ev || !ev.dir) continue;
                    // 같은 문서의 PulseDevice 가 보낸 것은 onLog 로 이미 받았다 — 중복 제거
                    if (D && ev.src && ev.src === D.ctxId) continue;
                    ev._other = true; addRow(ev, true);
                }
            };
            var announce = function () {
                try { ch.postMessage({ watch: 1, src: (D && D.ctxId) || '' }); } catch (_) {}
            };
            announce();
            setInterval(announce, 2000);
        }
    } catch (_) {}

    // ── 상태 ──
    function fmt(v) { return (v === '' || v == null) ? '—' : v; }
    function renderStatus(st) {
        $('o-state').textContent = st.connected ? '● 연결됨' : '미연결';
        $('o-state').style.color = st.connected ? 'var(--c-green)' : 'var(--tx-2)';
        $('o-label').textContent = fmt(st.portLabel);
        $('o-sent').textContent  = (st.sentCount || 0).toLocaleString();
        $('o-ok').textContent    = (st.writeOk || 0).toLocaleString();
        $('o-fail').textContent  = (st.writeErr || 0).toLocaleString();
        // 쓰기대기가 계속 1 이상이면 **기기가 우리 전송 속도를 못 따라오는 것**이다.
        $('o-q').textContent     = (st.queued || 0).toLocaleString();
        $('o-q').style.color     = (st.queued || 0) > 2 ? 'var(--c-amber, #d97706)' : '';
        $('o-info').textContent  = fmt(st.deviceInfo);
        $('o-err').textContent   = fmt(st.lastError);
        var i = st.input || {};
        $('i-state').textContent = i.connected ? '● 연결됨' : fmt(i.lastError) === '—' ? '미연결' : i.lastError;
        $('i-state').style.color = i.connected ? 'var(--c-green)' : 'var(--tx-2)';
        $('i-label').textContent = fmt(i.label);
        $('i-rx').textContent    = (i.rxCount || 0).toLocaleString();
        $('i-drop').textContent  = (i.dropped || 0).toLocaleString();
        $('i-last').textContent  = fmt(i.lastLine);
        $('b-relay').checked     = !!i.relay;
    }
    if (D) { renderStatus(D.getStatus()); D.onChange(renderStatus); }

    // ── 타이밍 ──
    // ⚠ 정렬이 들어가는 계산이라 상태 변경(수신 10건마다)에 묶지 않고 1초에 한 번만 본다.
    function num(v, unit) {
        if (v == null) return '—';
        return (v < 10 ? Math.round(v * 10) / 10 : Math.round(v)) + (unit || '');
    }
    function renderTiming() {
        if (!D || !D.getTiming) return;
        var t = D.getTiming();
        var rx = t.rx, rl = t.relay, w = t.write;
        $('t-rx-hz').textContent  = rx ? num(rx.hz, 'Hz') : '—';
        $('t-rx-avg').textContent = rx ? num(rx.avg, 'ms') : '—';
        $('t-rx-max').textContent = rx ? num(rx.max) + ' / ' + num(rx.p95, 'ms') : '—';
        $('t-rl-hz').textContent  = rl ? num(rl.hz, 'Hz') : '—';
        $('t-rl-avg').textContent = rl ? num(rl.avg, 'ms') : '—';
        $('t-rl-max').textContent = rl ? num(rl.max) + ' / ' + num(rl.p95, 'ms') : '—';
        $('t-w-avg').textContent  = w ? num(w.avg, 'ms') : '—';
        $('t-w-max').textContent  = w ? num(w.max) + ' / ' + num(w.p95, 'ms') : '—';
        $('t-pend').textContent   = t.pending ? ' 대기 중인 축 ' + t.pending + '개.' : '';
    }
    if (D) { renderTiming(); setInterval(renderTiming, 1000); }

    // ── 축 위치 (수신 vs 송신) ──────────────────────────────
    // 숫자만으로는 '어디로 어떻게' 움직이는지 안 보인다. 목표값·보간 위치·최근 궤적을 그린다.
    // 로그 이벤트만 보고 그리므로 device.js 를 건드리지 않는다 — 다른 탭의 입출력도 그대로 들어온다.
    //
    // TCode 값은 '0.xxx' 소수다 (L0500 = 0.500 = 50%). 자릿수가 몇이든 digits/10^자릿수.
    // I 는 그 위치까지 가는 데 쓸 시간(ms) → 그 사이를 선형 보간해 '지금 있어야 할 위치'를 만든다.
    var AX_RE = /([A-Z])([0-9])([0-9]+)(?:([IS])([0-9]+))?/g;
    var TRACE_MS = 5000;
    var axes = {}, axOrder = [], rxRecent = [], lags = [];

    function parseAxes(line) {
        AX_RE.lastIndex = 0;
        var out = [], m;
        while ((m = AX_RE.exec(line)) !== null) {
            var d = m[3];
            if (d.length > 5) continue;
            out.push({
                ax: m[1] + m[2],
                v:  parseInt(d, 10) / Math.pow(10, d.length),
                ms: (m[4] === 'I') ? Math.min(9999, Math.max(1, parseInt(m[5], 10))) : 0
            });
        }
        return out;
    }

    function curVal(s, now) {
        if (!s) return null;
        if (!s.ms) return s.v;
        var k = (now - s.at) / s.ms;
        if (k >= 1) return s.v;
        if (k <= 0) return s.from;
        return s.from + (s.v - s.from) * k;
    }

    function axEntry(ax) {
        if (axes[ax]) return axes[ax];
        var empty = $('ax-empty'); if (empty) empty.remove();
        var row = document.createElement('div');
        row.style.cssText = 'margin-bottom:12px;';
        function side(name) {
            return '<div class="ax-row">' +
                     '<b style="width:26px;">' + (name === 'rx' ? ax : '') + '</b>' +
                     '<span class="text-faint ax-lbl">' + (name === 'rx' ? '수신' : '송신') + '</span>' +
                     '<div class="ax-track" style="flex:1;">' +
                       '<span class="ax-fill ' + name + '"></span><span class="ax-tick ' + name + '"></span>' +
                     '</div>' +
                     '<span class="ax-num ' + name + '">—</span>' +
                   '</div>';
        }
        row.innerHTML = side('rx') + side('tx') +
            '<canvas class="ax-trace" width="600" height="42" ' +
            'style="width:100%; height:42px; background:#000; border-radius:6px; margin-top:2px;"></canvas>';
        $('ax-list').appendChild(row);
        var e = {
            rx: null, tx: null, trace: [],
            fill: { rx: row.querySelector('.ax-fill.rx'), tx: row.querySelector('.ax-fill.tx') },
            tick: { rx: row.querySelector('.ax-tick.rx'), tx: row.querySelector('.ax-tick.tx') },
            num:  { rx: row.querySelector('.ax-num.rx'),  tx: row.querySelector('.ax-num.tx') },
            cv: row.querySelector('.ax-trace')
        };
        axes[ax] = e; axOrder.push(ax);
        return e;
    }

    function feedAxis(ev) {
        if (!ev || (ev.dir !== 'in' && ev.dir !== 'out' && ev.dir !== 'relay')) return;
        var list = parseAxes(ev.text);
        var now = ev.ts || Date.now();
        var k = (ev.dir === 'in') ? 'rx' : 'tx';
        for (var i = 0; i < list.length; i++) {
            var a = list[i], e = axEntry(a.ax), prev = e[k];
            e[k] = { v: a.v, ms: a.ms, at: now, from: (prev != null) ? curVal(prev, now) : a.v };
        }
        // 수신 → 복사 지연: 복사는 수신 줄을 **그대로** 보내므로 같은 문자열을 거슬러 찾으면 된다
        var txt = String(ev.text).trim();
        if (ev.dir === 'in') {
            rxRecent.push({ text: txt, ts: now });
            if (rxRecent.length > 200) rxRecent.shift();
        } else if (ev.dir === 'relay') {
            for (var j = rxRecent.length - 1; j >= 0; j--) {
                if (rxRecent[j].text === txt) {
                    var d = now - rxRecent[j].ts;
                    if (d >= 0 && d < 3000) { lags.push(d); if (lags.length > 100) lags.shift(); }
                    break;
                }
            }
        }
    }

    function drawTrace(e, now) {
        var c = e.cv.getContext('2d'), w = e.cv.width, h = e.cv.height, tr = e.trace;
        c.fillStyle = '#000'; c.fillRect(0, 0, w, h);
        c.strokeStyle = 'rgba(255,255,255,.10)'; c.lineWidth = 1;
        c.beginPath(); c.moveTo(0, h / 2); c.lineTo(w, h / 2); c.stroke();
        // 수신을 굵게 **아래에** 깔고 송신을 가늘게 위에 그린다 —
        // 그대로 전달되면 초록 선이 파란 띠 **안에** 들어앉아 "겹쳤다"가 한눈에 보이고,
        // 어긋나면 파란 띠가 밖으로 비져나온다.
        ['rx', 'tx'].forEach(function (k) {
            c.beginPath(); c.strokeStyle = (k === 'rx') ? '#38bdf8' : '#4ade80';
            c.lineWidth = (k === 'rx') ? 3.4 : 1.4;
            var on = false;
            for (var i = 0; i < tr.length; i++) {
                var v = tr[i][k];
                if (v == null) { on = false; continue; }
                var x = w - (now - tr[i].t) / TRACE_MS * w;
                var y = h - 3 - v * (h - 6);
                if (!on) { c.moveTo(x, y); on = true; } else { c.lineTo(x, y); }
            }
            c.stroke();
        });
    }

    function axTick() {
        var now = Date.now();
        for (var i = 0; i < axOrder.length; i++) {
            var e = axes[axOrder[i]];
            var v = { rx: curVal(e.rx, now), tx: curVal(e.tx, now) };
            ['rx', 'tx'].forEach(function (k) {
                if (v[k] == null) return;
                e.fill[k].style.width = (v[k] * 100).toFixed(1) + '%';
                e.tick[k].style.left  = (e[k].v * 100).toFixed(1) + '%';
                e.num[k].textContent  = (v[k] * 100).toFixed(1) + '%';
            });
            e.trace.push({ t: now, rx: v.rx, tx: v.tx });
            while (e.trace.length && now - e.trace[0].t > TRACE_MS) e.trace.shift();
            drawTrace(e, now);
        }
        if (lags.length) {
            var sum = 0, mx = 0;
            for (var j = 0; j < lags.length; j++) { sum += lags[j]; if (lags[j] > mx) mx = lags[j]; }
            $('ax-lag').textContent = '수신→복사 지연 평균 ' + Math.round(sum / lags.length) +
                                      'ms · 최대 ' + mx + 'ms (' + lags.length + '건)';
        }
    }
    // ⚠ requestAnimationFrame 을 쓰면 안 된다 — 탭이 가려지거나 화면이 합성되지 않는 상황에서
    //   **아예 안 돈다**(여기서 실제로 한 번도 안 불렸다). 그러면 막대가 멈춘 채 거짓 상태를 보여준다.
    //   setInterval 은 숨은 탭에서 느려질 뿐 멈추지 않는다.
    setInterval(axTick, 33);

    function resetAxes() {
        axes = {}; axOrder = []; rxRecent = []; lags = [];
        $('ax-list').innerHTML = '<div class="text-faint" id="ax-empty" style="font-size:12px; padding:6px 0;">' +
            '아직 축 명령이 없습니다. 기기를 연결하거나 아래에서 <code>L050I500</code> 를 보내 보세요.</div>';
        $('ax-lag').textContent = '수신→복사 지연 —';
    }

    // ── 버튼 ──
    function guard(fn) {
        return async function () {
            try { await fn(); }
            catch (e) {
                if (e && e.name === 'NotFoundError') return;        // 선택 창을 닫은 것
                if (D && D.devLog) D.devLog('err', (e && e.message) || String(e), '조작');
            }
        };
    }
    $('b-ble').addEventListener('click', guard(function () { return D.connectBluetooth(); }));
    $('b-usb').addEventListener('click', guard(function () { return D.connectSerial(); }));
    $('b-out-dc').addEventListener('click', guard(function () { return D.disconnect(); }));
    $('b-in').addEventListener('click', guard(function () { return D.connectBluetoothInput(); }));
    $('b-in-dc').addEventListener('click', guard(function () { return D.disconnectInput(); }));
    $('b-relay').addEventListener('change', function () { D.setRelay($('b-relay').checked); });

    $('b-send').addEventListener('click', function () {
        var c = $('m-cmd').value.trim(); if (!c) return;
        if (!D.send(c)) D.devLog('err', c, '전송 실패 — 출력 미연결?');
    });
    $('b-send-remote').addEventListener('click', function () {
        var c = $('m-cmd').value.trim(); if (!c) return;
        var n = D.sendRemote(c);
        D.devLog('info', c, n ? ('검증 통과 — 토큰 ' + n + '개') : '검증기에서 거부됨');
    });

    $('b-pause').addEventListener('click', function () {
        paused = !paused;
        $('b-pause').textContent = paused ? '▶ 계속' : '⏸ 멈춤';
        if (!paused) redraw();
    });
    $('b-clear').addEventListener('click', function () {
        rows = []; logEl.textContent = ''; if (D.clearLog) D.clearLog();
        resetAxes();
    });
    document.querySelectorAll('#filters input').forEach(function (cb) { cb.addEventListener('change', redraw); });

    function asText() {
        return rows.map(function (ev) {
            return hhmmss(ev.ts) + '\t' + (LABEL[ev.dir] || ev.dir) + '\t' + ev.text
                 + (ev.meta ? '\t// ' + ev.meta : '') + (ev._other ? '\t[다른 탭]' : '');
        }).join('\n');
    }
    $('b-copy').addEventListener('click', async function () {
        try { await navigator.clipboard.writeText(asText()); $('b-copy').textContent = '복사됨'; }
        catch (e) { $('b-copy').textContent = '복사 실패'; }
        setTimeout(function () { $('b-copy').textContent = '복사'; }, 1200);
    });
    $('b-save').addEventListener('click', function () {
        var blob = new Blob([asText()], { type: 'text/plain;charset=utf-8' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'device-log-' + new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19) + '.txt';
        a.click();
        setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
    });

    if (D && D.devLog) D.devLog('info', '진단 창 열림');
})();
</script>
