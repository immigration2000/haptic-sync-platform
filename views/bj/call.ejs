<section class="container">
    <!-- 세션 룸: 영상 영역(스트리머가 틀면 표시) + 통화 사이드 -->
    <div class="session-room">
        <!-- 좌측: 영상 (영상 모드일 때만) / 통화 전용일 땐 스트리머 아바타 -->
        <div class="session-stage">
            <div id="session-call-view" class="session-callview">
                <div class="bj-thumb session-avatar"><%= (bj.stage_name || '?').replace(/^BJ-?/,'').charAt(0) %></div>
                <h1 class="player-title" style="margin-top: var(--sp-4);"><%= bj.stage_name %></h1>
                <p class="text-dim mt-3"><%= bj.description %></p>
                <div class="mt-3 mono" style="color: var(--c-yellow); font-size: 14px;"><%= bj.rate_per_minute %> Ruby / 분</div>
            </div>
            <div id="session-video-view" class="session-videoview hidden">
                <video id="session-video" controls playsinline style="width:100%; height:100%; object-fit:contain; background:#000;"></video>
                <div id="session-video-badge" class="session-video-badge hidden">🎬 스트리머가 재생 중</div>
                <!-- 내 카메라 미리보기. 스트리머에게 보내는 것과 같은 스트림. muted 필수 -->
                <video id="my-cam" autoplay playsinline muted class="hidden"
                       style="position:absolute; bottom:12px; right:12px; width:26%; max-width:160px; min-width:88px; aspect-ratio:4/3;
                              background:#000; border:2px solid rgba(94,255,176,0.6); border-radius:8px; object-fit:cover;"></video>
            </div>
        </div>

        <!-- 우측: 통화 컨트롤 -->
        <aside class="session-side">
            <div class="card card-body">
                <div class="panel-title">통화 세션</div>
                <div id="call-state" class="text-dim mb-3">대기 중 — "통화 시작"을 누르세요</div>
                <div id="call-stats" class="mono text-faint" style="font-size: 12px; display: grid; grid-template-columns: 78px 1fr; gap: 6px 10px;">
                    <span>모드</span><span id="call-mode">—</span>
                    <span>시간</span><span id="call-elapsed">00:00</span>
                    <span>디바이스</span><span id="call-device">—</span>
                    <span>제어</span><span id="call-ctrl">스트리머 수동</span>
                    <span>수신</span><span id="call-recv-count">0 cmd</span>
                    <span>송신</span><span id="call-send-count">0 cmd</span>
                </div>

                <%
                   // 제공 서비스는 서비스 태그가 기준. 요율은 rate_cam이 0이면 기본 요율로 폴백.
                   var svc = String(bj.services || '').split(',').filter(Boolean);   // 빈 값 = 라이브 미제공
                   var hasVideo1 = svc.indexOf('video_1on1') >= 0;
                   var videoRate = (bj.rate_cam > 0) ? bj.rate_cam : bj.rate_per_minute;
                %>
                <div class="form-row mt-4" id="tier-select">
                    <label class="form-label">옵션 선택</label>
                    <label class="svc-item" style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                        <input type="radio" name="tier" value="voice_1on1" checked>
                        <div><strong>🎤 1:1 음성통화</strong> <span class="text-faint" style="font-size:12px;">음성 + 디바이스 — <%= bj.rate_per_minute %> Ruby/분</span></div>
                    </label>
                    <% if (hasVideo1) { %>
                    <label class="svc-item" style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-top:6px;">
                        <input type="radio" name="tier" value="video_1on1">
                        <div><strong>📷 1:1 영상통화</strong> <span class="text-faint" style="font-size:12px;">화상 + 디바이스 · 함께보기 포함 — <%= videoRate %> Ruby/분</span></div>
                    </label>
                    <% } %>
                    <p class="text-faint mt-2" style="font-size:11px;">스트리머가 제공하는 옵션 중 선택하세요. 화면 전환·제어는 스트리머가 진행합니다.</p>
                </div>

                <div class="flex gap-3 mt-5" id="call-actions-start">
                    <button id="btn-start" class="btn btn-primary btn-lg btn-block">통화 시작</button>
                </div>
                <div class="flex gap-2 mt-5 hidden" id="call-actions-live">
                    <button id="btn-mic" class="btn btn-secondary" style="flex:1;">🎤 마이크</button>
                    <button id="btn-cam" class="btn btn-secondary" style="flex:1;" disabled title="연결되면 켤 수 있습니다">📷 카메라</button>
                    <button id="btn-hangup" class="btn btn-ghost" style="flex:1; background: rgba(255,80,80,0.1); border-color: rgba(255,80,80,0.4); color: #FFB8B8;">종료</button>
                </div>

                <!-- 스트리머 기기 제어 — 스트리머가 허용(ALLOW:1)해야 나타난다.
                     송신은 axis_sender 가 33ms 병합 + 변화율 제한으로 내보낸다. -->
                <div id="ctl-panel" class="mt-5 hidden" style="border-top:1px solid var(--border-soft); padding-top:14px;">
                    <div class="flex items-center gap-2 mb-2" style="justify-content:space-between;">
                        <strong style="font-size:12px;">🎮 스트리머 기기 제어</strong>
                        <span id="ctl-state" class="text-faint mono" style="font-size:11px;">허용됨</span>
                    </div>
                    <% const CAX = [['L0','스트로크 ↑↓','#FF2D5E'],['R0','롤 ←→','#7B2DFF'],['R2','피치 W/S','#5EFFB0']]; %>
                    <% CAX.forEach(a => { %>
                        <div style="margin-bottom:8px;">
                            <div style="display:flex; justify-content:space-between; font-size:11px; color:var(--tx-2);">
                                <span style="color:<%= a[2] %>; font-weight:700;"><%= a[0] %></span><span><%= a[1] %></span><span id="ctl-<%= a[0] %>-v" class="mono">50</span>
                            </div>
                            <input type="range" id="ctl-<%= a[0] %>" min="0" max="99" value="50" style="width:100%; accent-color:<%= a[2] %>;">
                        </div>
                    <% }) %>
                    <div style="display:flex; justify-content:space-between; font-size:11px; color:var(--tx-2); margin-top:6px;">
                        <span>보간(속도)</span><span id="ctl-interp-v" class="mono">100</span>
                    </div>
                    <input type="range" id="ctl-interp" min="50" max="500" value="100" step="10" style="width:100%;">
                    <p class="text-faint" style="font-size:11px; margin:8px 0 0;">스트리머가 연결한 기기가 움직입니다. 스트리머가 허용을 끄면 이 패널은 사라집니다.</p>
                </div>
            </div>

            <div class="card card-body" style="margin-top: var(--sp-4);">
                <div class="panel-title">안내</div>
                <p class="text-faint" style="font-size: 12px; line-height: 1.6;">
                    무료 체험 후 결제하면 통화가 이어집니다.<br>
                    이후 <strong>스트리머가 영상을 틀어주거나 디바이스를 직접 조작</strong>합니다. 영상·제어 전환 권한은 스트리머에게 있습니다.
                </p>
            </div>
        </aside>
    </div>
</section>

<style>
.session-room { display: grid; grid-template-columns: 1fr 340px; gap: var(--sp-5); padding: var(--sp-5) 0; }
@media (max-width: 1000px) { .session-room { grid-template-columns: 1fr; } }
.session-stage {
    background: #000; border-radius: var(--rad-md); overflow: hidden;
    aspect-ratio: 16/9; position: relative;
    display: flex; align-items: center; justify-content: center;
}
.session-callview { text-align: center; padding: var(--sp-5); }
.session-avatar {
    width: 120px; height: 120px; border-radius: 50%; margin: 0 auto;
    font-size: 48px; box-shadow: 0 16px 48px rgba(255,45,94,0.35);
    animation: callPulse 2s ease-in-out infinite;
}
@keyframes callPulse { 0%,100%{box-shadow:0 16px 48px rgba(255,45,94,0.35);} 50%{box-shadow:0 20px 64px rgba(255,45,94,0.65);} }
.session-videoview { position: absolute; inset: 0; }
.session-video-badge {
    position: absolute; top: 12px; left: 12px;
    background: rgba(0,0,0,0.7); border: 1px solid rgba(255,45,94,0.5);
    color: #FF4B7A; font-size: 12px; padding: 4px 10px; border-radius: 6px;
    font-family: var(--font-mono);
}
.hidden { display: none !important; }
</style>

<script>
window.__BJ_CALL__ = {
    bjId:   <%= bj.id %>,
    bjName: "<%= bj.stage_name %>",
};
</script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/vendor/simple-peer.min.js"></script>
<%# ⚠ device.js / funscript.js 는 layout.ejs 가 이미 로드한다. 여기서 다시 넣으면
    window.PulseDevice 가 새 인스턴스로 바뀌어 헤더(첫 인스턴스에 바인딩)와 이 페이지가
    서로 다른 기기 객체를 보게 된다 — 헤더는 '연결됨'인데 통화 화면은 '미연결'이 되고
    수신 명령이 기기로 가지 않는다 (2026-09-20 실기기 확인). %>
<script src="/js/core/bj_session.js"></script>
<script src="/js/core/axis_sender.js?v=1"></script>
<script src="/js/pages/bj_call.js?v=bidir"></script>
