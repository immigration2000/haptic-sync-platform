<section class="container">
    <div class="list-header">
        <div>
            <div class="section-eyebrow">PUBLIC LIVE · 진행 중</div>
            <h1 class="section-title" style="margin-bottom:0;">LIVE 방송 — 시청 가능</h1>
            <p class="text-dim mt-4">현재 송출 중인 스트리머. 시청 무료, 후원만 결제.</p>
        </div>
    </div>

    <div id="lobby-list" class="grid-list">
        <!-- 더미 방송 (서버 사이드 렌더) -->
        <% if (dummyRooms && dummyRooms.length) { %>
            <% dummyRooms.forEach(r => { %>
                <a class="card bj-card" href="/bj/dummy/<%= r.id %>" style="border: 1px solid rgba(255,184,94,0.3);">
                    <div class="bj-thumb" style="background: linear-gradient(135deg, #FFB85E, #FF2D5E);">
                        <%= r.stage_name.replace(/^[^가-힯a-zA-Z]+/,'').charAt(0) %>
                    </div>
                    <div class="bj-info">
                        <div class="bj-name"><%= r.stage_name %>
                            <span class="badge" style="background:rgba(255,80,80,0.2); color:#FF8080; font-size:9px; padding:2px 6px; margin-left:6px;">🔴 LIVE</span>
                        </div>
                        <div class="bj-desc"><%= r.description %></div>
                        <div class="bj-rate">
                            <span style="color: var(--c-green);">● 방송중</span>
                            <span><%= r.viewer_count %>명 시청</span>
                        </div>
                    </div>
                </a>
            <% }) %>
        <% } %>
        <!-- 실제 broadcaster (Socket.IO로 동적 추가) -->
    </div>

    <!-- 통화 대기 중인 스트리머 — 방송과 성격이 달라 섹션을 분리한다.
         (방송=시청 무료·후원 / 통화=분당 과금) -->
    <div id="call-section" style="display:none; margin-top:40px;">
        <div class="list-header">
            <div>
                <div class="section-eyebrow">1:1 · 지금 통화 가능</div>
                <h1 class="section-title" style="margin-bottom:0;">통화 대기 중인 스트리머</h1>
                <p class="text-dim mt-4">통화 콘솔을 켜둔 스트리머입니다. 분당 요금이 부과됩니다.</p>
            </div>
        </div>
        <div id="call-list" class="grid-list"></div>
    </div>
</section>

<script src="/socket.io/socket.io.js"></script>
<script>
(function () {
    const socket = io();
    const listEl = document.getElementById('lobby-list');
    socket.emit('broadcast-lobby-enter');
    function render(list) {
        if (!list || !list.length) {
            listEl.innerHTML = '<div class="text-faint text-center" style="padding: 80px 0; grid-column: 1 / -1;">진행 중인 방송이 없습니다.</div>';
            return;
        }
        listEl.innerHTML = '';
        for (const b of list) {
            const div = document.createElement('a');
            div.className = 'card bj-card';
            div.href = `/bj/watch/${b.broadcasterUserId}`;
            const initial = b.name.replace(/^BJ-?/, '').charAt(0);
            div.innerHTML = `
                <div class="bj-thumb">${initial}</div>
                <div class="bj-info">
                    <div class="bj-name">${b.name} <span class="badge" style="background:rgba(255,80,80,0.2); color:#FF8080; font-size:9px; padding:2px 6px; margin-left:6px;">🔴 LIVE</span></div>
                    <div class="bj-desc">${b.mode === 'voice' ? '📻 음성 방송' : '📺 영상 방송'} — 입장 무료 · 후원</div>
                    <div class="bj-rate">
                        <span style="color: var(--c-green);">● 송출중</span>
                        <span>${b.viewerCount}명 시청</span>
                    </div>
                </div>
            `;
            listEl.appendChild(div);
        }
    }
    socket.on('broadcast-list',         (list) => render(list));
    socket.on('broadcast-list-update',  (list) => render(list));

    // ── 통화 대기 목록 (bj-list) ──
    // 서버가 대기 풀이 바뀔 때마다 이 룸에도 쏜다. 없으면 섹션 자체를 숨긴다.
    const callSection = document.getElementById('call-section');
    const callListEl  = document.getElementById('call-list');
    socket.on('bj-list', (list) => {
        const arr = Array.isArray(list) ? list : [];
        if (!arr.length) { callSection.style.display = 'none'; callListEl.innerHTML = ''; return; }
        callSection.style.display = '';
        callListEl.innerHTML = '';
        for (const b of arr) {
            const a = document.createElement('a');
            a.className = 'card bj-card';
            a.href = '/bj/call/' + encodeURIComponent(b.userId);
            const initial = String(b.name || '?').replace(/^BJ-?/, '').charAt(0);
            const thumb = document.createElement('div');
            thumb.className = 'bj-thumb';
            thumb.style.background = 'linear-gradient(135deg, #5EFFB0, #7B2DFF)';
            thumb.textContent = initial;
            const info = document.createElement('div');
            info.className = 'bj-info';
            const nameEl = document.createElement('div');
            nameEl.className = 'bj-name';
            nameEl.textContent = b.name || '스트리머';       // textContent — XSS 차단
            const badge = document.createElement('span');
            badge.className = 'badge';
            badge.style.cssText = 'background:rgba(94,255,176,0.18); color:#5EFFB0; font-size:9px; padding:2px 6px; margin-left:6px;';
            badge.textContent = '📞 통화 가능';
            nameEl.appendChild(badge);
            const desc = document.createElement('div');
            desc.className = 'bj-desc';
            desc.textContent = '1:1 통화 대기 중 — 클릭하면 통화 요청';
            const rate = document.createElement('div');
            rate.className = 'bj-rate';
            rate.innerHTML = '<span style="color: var(--c-green);">● 대기중</span><span>분당 과금</span>';
            info.append(nameEl, desc, rate);
            a.append(thumb, info);
            callListEl.appendChild(a);
        }
    });
})();
</script>
