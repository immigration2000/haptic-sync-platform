<section class="container">
    <div class="player-wrap">
        <div>
            <% if (item.type === 'vr') { %>
            <div class="player-video vr-stage" id="vr-stage">
                <!-- 원본 VR 영상: 텍스처·오디오·funscript 타이밍 소스 (캔버스 뒤) -->
                <video id="player-video" autoplay muted playsinline
                       src="<%= item.video_path %>"
                       poster="<%= item.thumbnail_path || '' %>"
                       style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1;"></video>
                <canvas id="vr-canvas"></canvas>
                <div class="vr-badge">🅥🆁 재투영 (평면 변환)</div>
                <div class="vr-controls" id="vr-controls">
                    <button type="button" id="vr-play" class="vr-ctrl-btn" title="재생/일시정지">⏸</button>
                    <input type="range" id="vr-seek" class="vr-seek" min="0" max="1000" value="0">
                    <span id="vr-time" class="vr-time mono">00:00 / 00:00</span>
                    <button type="button" id="vr-mute" class="vr-ctrl-btn" title="음소거">🔇</button>
                    <button type="button" id="vr-adjust" class="vr-ctrl-btn" title="화면 조절">⚙</button>
                    <button type="button" id="vr-fs" class="vr-ctrl-btn" title="전체화면">⛶</button>
                </div>
            </div>
            <% } else { %>
            <div class="player-video">
                <video id="player-video" controls autoplay muted playsinline
                       src="<%= item.video_path %>"
                       poster="<%= item.thumbnail_path || '' %>"></video>
            </div>
            <% } %>
            <div class="player-info">
                <div class="flex items-center gap-3 mb-3">
                    <% if (item.type === 'vr') { %><span class="badge badge-vr">VR 원본 · 평면 재투영 보기</span><% } %>
                    <% if (item.multi_axis) { %><span class="badge badge-multi">다축 (L0·R0·R2)</span><% } %>
                    <% (item.tags || '').split(',').filter(Boolean).forEach(t => { %><span class="tag"><%= t.trim() %></span><% }) %>
                </div>
                <h1 class="player-title"><%= item.title %></h1>
                <div class="player-creator"><%= item.creator %></div>
                <p class="text-dim mt-4"><%= item.description %></p>
            </div>
        </div>

        <aside class="player-side">
            <div class="panel">
                <div class="panel-title">스트리머와 함께</div>
                <p class="text-dim mb-3" style="font-size:13px;">스트리머와 통화하면서 영상을 함께 볼 수 있습니다. 통화 중 스트리머가 영상을 틀어주고 디바이스도 조작합니다.</p>
                <a href="/bj" class="btn btn-secondary btn-block">🎙 스트리머 통화하기 →</a>
            </div>
            <div class="panel">
                <div class="panel-title">DEVICE STATUS</div>
                <div id="player-dev-status" class="text-dim" style="font-size: 13px;">
                    <span class="text-faint">우상단 메뉴에서 디바이스를 연결하세요.</span>
                </div>
            </div>
            <div class="panel">
                <div class="panel-title">스트로크 제어 (L0)</div>

                <div style="display:flex; gap:18px; align-items:flex-start; justify-content:center;">

                    <!-- 실제 움직임 범위 미리보기 -->
                    <div style="display:flex; gap:6px; height:200px;">
                        <div style="display:flex;flex-direction:column;justify-content:space-between;
                                    width:34px;text-align:right;font-size:10px;color:var(--tx-3);">
                            <span>100<br><span style="font-size:9px;">깊음</span></span>
                            <span>50</span>
                            <span><span style="font-size:9px;">얕음</span><br>0</span>
                        </div>
                        <div style="position:relative;width:42px;background:var(--bg-3);
                                    border-radius:var(--rad-sm);overflow:hidden;">
                            <div id="viz-limit" style="position:absolute;left:0;right:0;
                                    background:rgba(123,45,255,0.18);
                                    border-top:1px solid var(--c-purple);border-bottom:1px solid var(--c-purple);"></div>
                            <div id="viz-actual" style="position:absolute;left:8px;right:8px;min-height:3px;
                                    background:var(--gradient-main);border-radius:var(--rad-pill);"></div>
                            <div id="viz-marker" style="position:absolute;left:0;right:0;height:2px;
                                    background:var(--c-green);opacity:0;transition:bottom .08s linear;"></div>
                        </div>
                        <div style="position:relative;width:78px;">
                            <div id="viz-src" style="position:absolute;left:0;width:3px;min-height:2px;
                                    background:var(--tx-3);border-radius:2px;"></div>
                            <div id="viz-src-lbl" style="position:absolute;left:8px;font-size:10px;
                                    color:var(--tx-3);white-space:nowrap;transform:translateY(50%);"></div>
                        </div>
                    </div>

                    <!-- 기기 이동 한계 — 세로 이중 손잡이 -->
                    <!-- 슬라이더 + 아래 글씨를 합쳐 미리보기 막대와 같은 높이(200px)로 맞춘다.
                         슬라이더는 flex:1 로 남는 높이를 채우므로 글꼴이 바뀌어도 총 높이가 유지된다. -->
                    <!-- 바깥 높이(200px)는 그대로 두고 위아래 여백만 줘서 슬라이더만 짧아지게 한다.
                         (박스는 절대 배치라 이 여백에 영향받지 않는다) -->
                    <div style="position:relative;display:flex;flex-direction:column;align-items:center;
                                height:200px;padding:8px 0;box-sizing:border-box;">
                        <!-- 강도 바와 같은 라운드 박스. 배경 레이어로 깔아 레이아웃에 영향을 주지 않는다
                             (padding/border 를 주면 슬라이더가 밀려 눈금과 어긋난다) -->
                        <div class="ctl-box" aria-hidden="true"></div>
                        <span class="v-cap" title="움직임의 중심과 허용 범위. 두 손잡이의 가운데가 중심이 됩니다.">중심</span>
                        <div id="vlimit" class="v-range" style="flex:1;position:relative;z-index:1;">
                            <div class="v-track"></div>
                            <div class="v-fill" id="v-fill"></div>
                            <div class="v-thumb" id="v-thumb-max" data-which="max"></div>
                            <div class="v-thumb" id="v-thumb-min" data-which="min"></div>
                        </div>
                        <!-- 숫자 칸을 3ch 고정 폭으로 두어 0→1→100 으로 자릿수가 변해도
                             묶음이 옆으로 늘어나지 않게 한다 -->
                        <span class="v-val mono">
                            <span class="v-num" id="out-min-value">0</span><span class="v-sep">~</span><span class="v-num v-num-r" id="out-max-value">100</span>
                        </span>
                    </div>
                </div>

                <div id="viz-text" class="mono"
                     style="font-size:11px;color:var(--tx-2);margin-top:12px;text-align:center;"></div>

                <!-- 체크박스를 글씨 바로 옆에 붙인다 (양끝 정렬이 아니라) -->
                <label class="sw-row" style="margin-top:12px;cursor:pointer;justify-content:flex-start;gap:10px;">
                    <div class="sw-text" style="flex:none;"><strong>스크립트 진폭 자동 확장</strong></div>
                    <input type="checkbox" class="sw" id="expand-toggle" checked>
                </label>

                <div class="stroke-ctl" id="gain-row">
                    <span class="stroke-ctl-lbl">강도</span>
                    <input type="range" id="intensity-slider" min="-80" max="80" step="5" value="0">
                    <span id="intensity-value" class="mono stroke-ctl-val">0%</span>
                </div>

                <p class="text-faint" style="font-size:11px;margin-top:8px;">
                    <span id="fs-span-label"></span>
                    <button type="button" id="stroke-reset" class="text-faint"
                            style="background:none;border:none;padding:0;margin-top:4px;text-decoration:underline;
                                   cursor:pointer;font-size:11px;display:block;">기본값으로</button>
                </p>

                <!-- 값 보관용 (조작은 위 세로 슬라이더가 한다) -->
                <input type="range" id="out-min-slider" min="0" max="100" step="1" value="0" style="display:none;">
                <input type="range" id="out-max-slider" min="0" max="100" step="1" value="100" style="display:none;">
            </div>
            <div class="panel">
                <div class="panel-title">FUNSCRIPT</div>
                <div class="text-dim mono" style="font-size: 12px;">
                    <div>파일: <span id="fs-file" class="text-faint"><%= item.script_path || '없음' %></span></div>
                    <div>축: <span id="fs-axes" class="text-faint">—</span></div>
                </div>
            </div>
        </aside>
    </div>
</section>

<% if (item.type === 'vr') { %>
<style>
    .vr-stage { position: relative; background: #000; aspect-ratio: 16/9; overflow: hidden; border-radius: 12px; }
    #vr-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; display: block; background: #000; }
    .vr-badge {
        position: absolute; top: 12px; left: 12px; z-index: 3;
        background: rgba(123,45,255,0.85); color: #fff; font-size: 12px; font-weight: 700;
        padding: 5px 10px; border-radius: 6px; letter-spacing: .3px; pointer-events: none;
        box-shadow: 0 2px 10px rgba(0,0,0,.4);
    }
    .vr-controls {
        position: absolute; left: 0; right: 0; bottom: 0; z-index: 4;
        display: flex; align-items: center; gap: 10px; padding: 10px 14px;
        background: linear-gradient(transparent, rgba(0,0,0,.75)); opacity: 0; transition: opacity .2s;
    }
    .vr-stage:hover .vr-controls, .vr-controls:focus-within { opacity: 1; }
    .vr-ctrl-btn {
        background: none; border: none; color: #fff; font-size: 18px; cursor: pointer;
        line-height: 1; padding: 2px 4px;
    }
    .vr-seek { flex: 1; accent-color: var(--c-purple, #7B2DFF); cursor: pointer; height: 4px; }
    .vr-time { color: #fff; font-size: 12px; min-width: 104px; text-align: right; }
</style>
<% } %>
<script>
window.__PLAYER__ = {
    contentId: <%= item.id %>,
    type:      "<%= item.type %>",
    fsPath:    "<%= item.script_path || '' %>",
    vrDefaults: <%- JSON.stringify(vrDefaults || null) %>
};
</script>
<% if (item.type === 'vr') { %><script src="/js/core/vr_reproject.js?v=7"></script><% } %>
<script src="/js/pages/player.js?v=span10"></script>
