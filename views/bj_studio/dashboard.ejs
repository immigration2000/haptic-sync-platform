<section class="container">
    <div class="mypage-grid">
        <%- include('_nav') %>

        <div>
            <div class="section-eyebrow">스트리머 STUDIO · 대시보드</div>
            <h1 class="section-title"><%= profile.stage_name %> <span class="text-faint mono" style="font-size: 14px;">@<%= user.nickname %></span></h1>
            <p class="text-dim mb-5"><%= profile.description || '자기소개를 입력해주세요.' %></p>

            <!-- 빠른 액션 -->
            <% const svc = String(profile.services || '').split(',').filter(Boolean);
               const labels = { voice_1on1:'🎤 1:1 음성통화', video_1on1:'📷 1:1 영상통화',
                                voice_multi:'📻 음성방송', video_multi:'📺 영상방송' };
               const oneToOne = ['voice_1on1','video_1on1'].filter(s => svc.includes(s));
               const multi    = ['voice_multi','video_multi'].filter(s => svc.includes(s)); %>

            <div class="section-eyebrow" style="margin-bottom: 12px;">방송 시작 — 여기서만 가능</div>
            <div class="grid grid-2 mb-5">
                <% if (oneToOne.length) { %>
                <a href="/bj/console" class="card card-body" style="border-color: var(--c-red); text-decoration: none;">
                    <div style="font-size: 32px; margin-bottom: 8px;">📞</div>
                    <div style="font-size: 18px; font-weight: 700; margin-bottom: 6px;">통화 콘솔</div>
                    <p class="text-dim" style="font-size: 13px;">대기 풀에 등록 → 자동 매칭</p>
                    <div class="mt-3" style="display:flex; gap:6px; flex-wrap:wrap;">
                        <% oneToOne.forEach(s => { %><span class="tag"><%= labels[s] %></span><% }) %>
                    </div>
                    <div class="mt-4"><span class="btn btn-primary btn-sm">방송 시작 →</span></div>
                </a>
                <% } %>
                <% if (multi.length) { %>
                <a href="/bj/broadcast" class="card card-body" style="border-color: #FF8080; text-decoration: none;">
                    <div style="font-size: 32px; margin-bottom: 8px;">🔴</div>
                    <div style="font-size: 18px; font-weight: 700; margin-bottom: 6px;">공개 라이브</div>
                    <p class="text-dim" style="font-size: 13px;">다수 시청자에게 동시 송출. 시청료 + 후원.</p>
                    <div class="mt-4"><span class="btn btn-secondary btn-sm" style="border-color: #FF8080; color: #FF8080;">송출 시작 →</span></div>
                </a>
                <% } %>
                <% if (!oneToOne.length && !multi.length) { %>
                <div class="card card-body" style="grid-column: 1/-1;">
                    <p class="text-dim">제공 서비스가 없습니다. <a href="/bj-studio/profile" style="color: var(--c-pink);">프로필에서 서비스를 선택</a>하세요.</p>
                </div>
                <% } %>
            </div>

            <!-- 통계 -->
            <div class="grid grid-4 mb-5">
                <div class="card card-body text-center">
                    <div class="mono text-faint" style="font-size: 11px;">총 통화 수</div>
                    <div style="font-size: 28px; font-weight: 700; margin-top: 8px;"><%= stats.total_calls %></div>
                </div>
                <div class="card card-body text-center">
                    <div class="mono text-faint" style="font-size: 11px;">총 통화 시간</div>
                    <div style="font-size: 28px; font-weight: 700; margin-top: 8px;">
                        <%= Math.floor((stats.total_seconds || 0) / 60) %>
                        <span style="font-size: 14px; color: var(--tx-2);">분</span>
                    </div>
                </div>
                <div class="card card-body text-center">
                    <div class="mono text-faint" style="font-size: 11px;">누적 수익 (Gross)</div>
                    <div style="font-size: 28px; font-weight: 700; margin-top: 8px; color: var(--c-yellow);" class="mono"><%= (stats.total_earned || 0).toLocaleString() %></div>
                </div>
                <div class="card card-body text-center">
                    <div class="mono text-faint" style="font-size: 11px;">평점</div>
                    <div style="font-size: 28px; font-weight: 700; margin-top: 8px; color: var(--c-yellow);"><%= profile.rating_avg.toFixed(1) %> ★</div>
                    <div class="text-faint" style="font-size: 11px;"><%= profile.rating_count %>개 평가</div>
                </div>
            </div>

            <!-- 프로필 현황 -->
            <div class="card card-body">
                <div class="panel-title">현재 프로필</div>
                <div class="mono text-faint" style="font-size:13px; display:grid; grid-template-columns:120px 1fr; gap:8px 16px;">
                    <span>활동명</span>     <span style="color: white;"><%= profile.stage_name %></span>
                    <span>분당 요금</span>  <span style="color: var(--c-yellow);"><%= profile.rate_per_minute %> Ruby</span>
                    <span>태그</span>       <span>
                        <% (profile.tags || '').split(',').filter(Boolean).forEach(t => { %><span class="tag"><%= t.trim() %></span><% }) %>
                    </span>
                    <span>가입일</span>     <span class="text-faint" style="font-size:11px;"><%= profile.updated_at %></span>
                    <span>온라인</span>     <span><%= profile.is_online ? '<span style="color: var(--c-green);">● 방송 중</span>' : '○ 오프라인' %></span>
                </div>
                <a href="/bj-studio/profile" class="btn btn-ghost btn-sm mt-4">프로필 편집 →</a>
            </div>
        </div>
    </div>
</section>
