<section class="container">
    <div class="mypage-grid">
        <%- include('_nav') %>

        <div>
            <div class="section-eyebrow">스트리머 STUDIO · 프로필</div>
            <h1 class="section-title">프로필 편집</h1>

            <% if (typeof error !== 'undefined' && error) { %><div class="flash-error"><%= error %></div><% } %>
            <% if (typeof ok !== 'undefined' && ok) { %>
                <div class="flash-error" style="background: rgba(0,220,130,0.1); border-color: rgba(0,220,130,0.3); color: #5EFFB0;">✓ <%= ok %></div>
            <% } %>

            <div class="card card-body">
                <form method="POST" action="/bj-studio/profile">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <!-- ① 운영 방식 — 업로드 전용이면 아래 라이브 설정이 통째로 사라진다 -->
                    <div class="sw-row sw-master" id="row-upload-only">
                        <div class="sw-text">
                            <strong>📤 영상 업로드 전용</strong>
                            <span>라이브(통화·방송)를 하지 않고 <strong>영상 업로드·판매만</strong> 합니다.</span>
                        </div>
                        <input type="checkbox" class="sw" id="upload-only" <%= mySvc.length ? '' : 'checked' %>>
                    </div>

                    <!-- ② 라이브 서비스 — 스위치를 켜면 바로 아래에 설정이 펼쳐진다 -->
                    <div id="live-block">
                        <div class="form-label" style="margin:18px 0 8px;">라이브 서비스 — 켠 것만 사용자에게 노출됩니다</div>

                        <% serviceTypes.forEach(function (sv) { %>
                        <div class="sw-item" data-code="<%= sv.code %>" data-audience="<%= sv.audience %>">
                            <div class="sw-row">
                                <div class="sw-text">
                                    <strong><%= sv.icon %> <%= sv.label %></strong>
                                    <span><%= sv.desc %></span>
                                </div>
                                <input type="checkbox" class="sw svc-check" name="services" value="<%= sv.code %>"
                                       data-code="<%= sv.code %>" data-audience="<%= sv.audience %>"
                                       <%= mySvc.includes(sv.code) ? 'checked' : '' %>>
                            </div>

                            <div class="sw-panel">
                                <% if (sv.code === 'voice_1on1') { %>
                                    <div class="form-row" style="margin:0;">
                                        <label class="form-label">🎤 음성통화 분당 요금 (50~1000 Ruby)</label>
                                        <input class="form-input" type="number" name="rate_per_minute"
                                               value="<%= profile.rate_per_minute %>" min="0" max="1000">
                                    </div>
                                <% } else if (sv.code === 'video_1on1') { %>
                                    <div class="form-row" style="margin:0;">
                                        <label class="form-label">📷 영상통화 분당 요금
                                            <span class="text-faint" style="font-size:10px;">0 = 음성 요금과 동일</span></label>
                                        <input class="form-input" type="number" name="rate_cam"
                                               value="<%= profile.rate_cam %>" min="0" max="2000" step="10">
                                    </div>
                                <% } else { %>
                                    <p class="text-faint" style="font-size:12px;margin:0;">
                                        방송은 <strong>입장 무료 + 후원</strong>이라 정할 요금이 없습니다.
                                        시청자 후원이 그대로 수익이 됩니다.
                                    </p>
                                <% } %>
                            </div>
                        </div>
                        <% }) %>

                        <!-- 1:1 공통 설정 — 1:1을 하나라도 켜면 펼쳐진다 -->
                        <div class="sw-item" id="common-1on1">
                            <div class="sw-panel" style="border-top:none;">
                                <div class="form-label" style="margin-bottom:8px;">1:1 공통 설정</div>
                                <div class="grid grid-2 gap-3">
                                    <div class="form-row" style="margin:0;">
                                        <label class="form-label">무료 체험 시간 (초) — 0~120</label>
                                        <input class="form-input" type="number" name="free_preview_sec"
                                               value="<%= profile.free_preview_sec %>" min="0" max="120" step="10">
                                    </div>
                                    <div class="form-row" style="margin:0;">
                                        <label class="form-label">시간제 결제 단위 (분) — 1~60</label>
                                        <input class="form-input" type="number" name="session_block_min"
                                               value="<%= profile.session_block_min %>" min="1" max="60">
                                    </div>
                                </div>
                                <div style="background:rgba(123,45,255,0.08);border-radius:var(--rad-sm);padding:10px 12px;margin-top:12px;">
                                    <div class="mono text-faint" style="font-size:11px;">미리보기</div>
                                    <p class="text-dim" style="font-size:13px;margin:4px 0 0;">
                                        <strong id="pv-free" style="color:var(--c-pink);"><%= profile.free_preview_sec %></strong>초 무료 체험 후,
                                        <strong id="pv-block" style="color:var(--c-pink);"><%= profile.session_block_min %></strong>분에
                                        <strong id="pv-cost" style="color:var(--c-yellow);"><%= (profile.rate_per_minute * profile.session_block_min).toLocaleString() %></strong> Ruby 결제
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="sw-row" style="margin-top:10px;">
                            <div class="sw-text">
                                <strong>🔌 기기 제어 제공</strong>
                                <span>통화·방송 중 내가 시청자 디바이스를 조작합니다.</span>
                            </div>
                            <input type="checkbox" class="sw" name="device_control" value="1" <%= profile.device_control ? 'checked' : '' %>>
                        </div>
                    </div>

                    <!-- ③ 기본 정보 -->
                    <div class="form-label" style="margin:22px 0 8px;">기본 정보</div>
                    <div class="form-row">
                        <label class="form-label">활동명 (스테이지명)</label>
                        <input class="form-input" type="text" name="stage_name" value="<%= profile.stage_name %>" required maxlength="30">
                    </div>
                    <div class="form-row">
                        <label class="form-label">자기 소개</label>
                        <textarea class="form-input" name="description" rows="3" maxlength="300"><%= profile.description %></textarea>
                    </div>
                    <div class="form-row">
                        <label class="form-label">태그 (콤마 구분)</label>
                        <input class="form-input" type="text" id="tag-input" name="tags" value="<%= profile.tags || '' %>" placeholder="예: 청순,성숙,코스프레" maxlength="100">
                        <% if (approvedTags && approvedTags.length) { %>
                            <div class="text-faint mt-2" style="font-size:11px;">공용 태그 — 눌러서 추가</div>
                            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;">
                                <% approvedTags.slice(0, 30).forEach(function (t) { %>
                                    <button type="button" class="tag tag-pick" data-tag="<%= t.name %>"
                                            style="cursor:pointer;border:1px solid var(--border-soft);background:none;">
                                        <%= t.name %><% if (t.use_count) { %> <span class="text-faint"><%= t.use_count %></span><% } %>
                                    </button>
                                <% }) %>
                            </div>
                        <% } %>
                        <p class="text-faint mt-2" style="font-size:11px;">
                            <% if (tagMode === 'approval') { %>현재 <strong>승인제</strong> — 공용 태그는 바로 적용, 새 태그는 관리자 승인 후 공개.
                            <% } else if (tagMode === 'filter') { %>현재 <strong>자유입력(금지어 필터)</strong> — 금지어만 아니면 즉시 적용.
                            <% } else { %>현재 <strong>자유입력</strong> — 즉시 적용.<% } %> 최대 10개.
                        </p>
                    </div>

                    <!-- ④ 영상 판매·구독 — 라이브 여부와 무관하게 항상 사용 -->
                    <div class="card card-body mb-4" style="border-color:rgba(0,220,130,0.2);">
                        <div class="panel-title">영상 판매 · 멤버십 구독</div>
                        <p class="text-faint" style="font-size:11px;margin:0 0 10px;">
                            업로드한 영상에 적용됩니다. 라이브를 하지 않아도 <strong>영상만 판매</strong>할 수 있습니다.
                        </p>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                            <div class="form-row" style="margin:0;">
                                <label class="form-label">구독 가격 (Ruby) — 0이면 구독 미제공</label>
                                <input class="form-input" type="number" name="sub_price" value="<%= profile.sub_price %>" min="0" max="100000" step="100">
                            </div>
                            <div class="form-row" style="margin:0;">
                                <label class="form-label">구독 기간 (일)</label>
                                <input class="form-input" type="number" name="sub_days" value="<%= profile.sub_days %>" min="1" max="365">
                            </div>
                        </div>
                        <p class="text-faint mt-2" style="font-size:11px;">
                            ⚠ 구독가가 <strong>0</strong>이면 가격을 안 매긴 영상(= 구독 전용)은
                            <strong>아무도 볼 수 없습니다.</strong> 구독가를 정하거나
                            <a href="/bj-studio/videos">내 영상</a>에서 개별구매 가격을 매기세요.
                        </p>
                        <div class="sw-row" style="margin-top:12px;">
                            <div class="sw-text">
                                <strong>🔓 구독전용 영상 노출</strong>
                                <span>전체 영상 목록에 잠금 상태로 표시 (구독 유도)</span>
                            </div>
                            <input type="checkbox" class="sw" name="show_sub_videos" value="1" <%= profile.show_sub_videos ? 'checked' : '' %>>
                        </div>
                    </div>

                    <button class="btn btn-primary">저장</button>
                </form>
            </div>

            <div class="card card-body mt-5" style="background: rgba(255, 184, 94, 0.05);">
                <div class="panel-title" style="color: var(--c-yellow);">💡 프로필 작성 팁</div>
                <ul class="text-dim" style="padding-left: 20px; line-height: 1.8; font-size: 13px;">
                    <li><strong>활동명</strong>: 사용자가 카드에서 처음 보는 이름. 짧고 기억에 남는 형태가 좋습니다.</li>
                    <li><strong>자기 소개</strong>: 1~2문장. 분위기·스타일을 함축적으로.</li>
                    <li><strong>요금</strong>: 1:1 신규는 100~150 Ruby/분 추천. 평점·후기가 쌓이면 인상.</li>
                    <li><strong>태그</strong>: 3개 이내 권장. 검색·필터에 사용됩니다.</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<style>
/* 좌우로 움직이는 토글 스위치 */
.sw {
    appearance: none; -webkit-appearance: none;
    width: 46px; height: 26px; flex: none;
    border-radius: var(--rad-pill);
    background: var(--bg-3);
    border: 1px solid var(--border-soft);
    position: relative; cursor: pointer;
    transition: background .15s ease;
}
.sw::after {
    content: ''; position: absolute; top: 2px; left: 2px;
    width: 20px; height: 20px; border-radius: 50%;
    background: var(--tx-3);
    transition: transform .15s ease, background .15s ease;
}
.sw:checked { background: var(--c-purple); border-color: var(--c-purple); }
.sw:checked::after { transform: translateX(20px); background: #fff; }

.sw-row {
    display: flex; align-items: center; gap: 14px;
    padding: 12px 14px;
    background: var(--bg-2);
    border: 1px solid var(--border-soft);
    border-radius: var(--rad-md);
}
.sw-row.sw-master { border-color: rgba(123,45,255,0.35); background: rgba(123,45,255,0.07); }
.sw-text { flex: 1; min-width: 0; }
.sw-text strong { display: block; font-size: 14px; }
.sw-text span { display: block; font-size: 11px; color: var(--tx-3); margin-top: 2px; }

/* 스위치를 켜면 바로 아래로 설정이 펼쳐진다 */
.sw-item { margin-bottom: 8px; }
.sw-item .sw-panel {
    display: none;
    padding: 14px;
    border: 1px solid var(--border-soft);
    border-top: none;
    border-radius: 0 0 var(--rad-md) var(--rad-md);
    background: var(--bg-1);
}
.sw-item.on .sw-panel { display: block; }
.sw-item.on > .sw-row { border-radius: var(--rad-md) var(--rad-md) 0 0; border-bottom-color: transparent; }
#live-block.hidden-block { display: none; }
</style>

<script>
(function () {
    /* 공용 태그 클릭 → 태그 입력에 추가 */
    document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('.tag-pick');
        if (!b) return;
        var inp = document.getElementById('tag-input');
        if (!inp) return;
        var cur = inp.value.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
        var t = b.getAttribute('data-tag');
        if (cur.indexOf(t) === -1) { cur.push(t); inp.value = cur.join(','); }
    });

    var uploadOnly = document.getElementById('upload-only');
    var liveBlock  = document.getElementById('live-block');
    var common1on1 = document.getElementById('common-1on1');
    var checks     = [].slice.call(document.querySelectorAll('.svc-check'));
    var rateEl     = document.querySelector('input[name="rate_per_minute"]');

    function sync() {
        var only = uploadOnly && uploadOnly.checked;

        /* 업로드 전용이면 라이브 블록을 통째로 숨기고 서비스를 전부 해제한다.
           체크된 채 숨기기만 하면 폼이 그대로 전송돼 라이브가 켜진 상태로 저장된다. */
        if (only) checks.forEach(function (c) { c.checked = false; });
        if (liveBlock) liveBlock.classList.toggle('hidden-block', only);

        var any1on1 = false;
        checks.forEach(function (c) {
            var item = c.closest('.sw-item');
            if (item) item.classList.toggle('on', c.checked);
            if (c.checked && c.getAttribute('data-audience') === '1on1') any1on1 = true;
        });

        if (common1on1) common1on1.classList.toggle('on', any1on1 && !only);

        /* 1:1을 켰을 때만 분당 요금을 브라우저에서도 필수/하한 검사 */
        if (rateEl) {
            rateEl.required = any1on1 && !only;
            rateEl.min = (any1on1 && !only) ? '50' : '0';
        }
        upd();
    }

    /* 1:1 미리보기 */
    var free  = document.querySelector('input[name="free_preview_sec"]');
    var block = document.querySelector('input[name="session_block_min"]');
    var pvFree = document.getElementById('pv-free');
    var pvBlock = document.getElementById('pv-block');
    var pvCost = document.getElementById('pv-cost');
    function upd() {
        if (!pvFree || !pvBlock || !pvCost || !rateEl) return;
        pvFree.textContent = free.value || 0;
        pvBlock.textContent = block.value || 0;
        pvCost.textContent = ((parseInt(rateEl.value || 0, 10) * parseInt(block.value || 0, 10)) || 0).toLocaleString();
    }
    [rateEl, free, block].forEach(function (el) { el && el.addEventListener('input', upd); });

    checks.forEach(function (c) { c.addEventListener('change', sync); });
    /* 서비스를 하나라도 켜면 업로드 전용은 자동 해제 */
    checks.forEach(function (c) {
        c.addEventListener('change', function () {
            if (c.checked && uploadOnly && uploadOnly.checked) { uploadOnly.checked = false; sync(); }
        });
    });
    uploadOnly && uploadOnly.addEventListener('change', sync);
    sync();
})();
</script>
