<section class="container">
    <div class="mypage-grid">
        <%- include('_nav') %>

        <div>
            <div class="section-eyebrow">스트리머 STUDIO · 프로필</div>
            <h1 class="section-title">프로필 편집</h1>

            <% if (typeof error !== 'undefined' && error) { %><div class="flash-error"><%= error %></div><% } %>
            <% if (typeof ok !== 'undefined' && ok) { %>
                <div class="flash-error" style="background: rgba(0,220,130,0.1); border-color: rgba(0,220,130,0.3); color: #5EFFB0;">✓ <%= ok %></div>
            <% } %>

            <div class="card card-body">
                <form method="POST" action="/bj-studio/profile">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <!-- ① 제공 서비스 — 아래 설정들이 이 선택에 따라 켜지고 꺼진다 -->
                    <div class="form-row">
                        <label class="form-label">① 제공 서비스</label>
                        <p class="text-faint" style="font-size:11px;margin:0 0 8px;">
                            여기서 고른 것만 사용자에게 노출됩니다.
                            <strong>선택에 따라 아래 설정이 자동으로 켜지고 꺼집니다.</strong>
                            영상 업로드만 할 계획이면 골라도 되고 안 골라도 됩니다.
                        </p>
                        <div class="svc-grid">
                            <% serviceTypes.forEach(function (sv) { %>
                            <label class="svc-item">
                                <input type="checkbox" class="svc-check" name="services" value="<%= sv.code %>"
                                       data-audience="<%= sv.audience %>" data-code="<%= sv.code %>"
                                       <%= mySvc.includes(sv.code) ? 'checked' : '' %>>
                                <div>
                                    <strong><%= sv.icon %> <%= sv.label %></strong>
                                    <span><%= sv.desc %></span>
                                    <span style="color:<%= sv.billing === 'donation' ? 'var(--c-green)' : 'var(--c-yellow)' %>;font-size:10px;">
                                        <%= sv.billing === 'donation' ? '입장 무료 · 후원' : '분당 과금' %>
                                    </span>
                                </div>
                            </label>
                            <% }) %>
                        </div>
                    </div>

                    <!-- ② 기본 정보 -->
                    <div class="form-row">
                        <label class="form-label">② 활동명 (스테이지명)</label>
                        <input class="form-input" type="text" name="stage_name" value="<%= profile.stage_name %>" required maxlength="30">
                    </div>
                    <div class="form-row">
                        <label class="form-label">자기 소개</label>
                        <textarea class="form-input" name="description" rows="3" maxlength="300"><%= profile.description %></textarea>
                    </div>
                    <div class="form-row">
                        <label class="form-label">태그 (콤마 구분)</label>
                        <input class="form-input" type="text" id="tag-input" name="tags" value="<%= profile.tags || '' %>" placeholder="예: 청순,성숙,코스프레" maxlength="100">
                        <% if (approvedTags && approvedTags.length) { %>
                            <div class="text-faint mt-2" style="font-size:11px;">공용 태그 — 눌러서 추가</div>
                            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;">
                                <% approvedTags.slice(0, 30).forEach(function (t) { %>
                                    <button type="button" class="tag tag-pick" data-tag="<%= t.name %>"
                                            style="cursor:pointer;border:1px solid var(--border-soft);background:none;">
                                        <%= t.name %><% if (t.use_count) { %> <span class="text-faint"><%= t.use_count %></span><% } %>
                                    </button>
                                <% }) %>
                            </div>
                        <% } %>
                        <p class="text-faint mt-2" style="font-size:11px;">
                            <% if (tagMode === 'approval') { %>현재 <strong>승인제</strong> — 공용 태그는 바로 적용, 새 태그는 관리자 승인 후 공개.
                            <% } else if (tagMode === 'filter') { %>현재 <strong>자유입력(금지어 필터)</strong> — 금지어만 아니면 즉시 적용.
                            <% } else { %>현재 <strong>자유입력</strong> — 즉시 적용.<% } %> 최대 10개.
                        </p>
                    </div>

                    <!-- ③ 1:1 설정 — 1:1 서비스를 고르지 않으면 비활성 -->
                    <div class="card card-body mb-4 opt-sec" data-needs="1on1" style="border-color:rgba(123,45,255,0.2);">
                        <div class="panel-title">③ 1:1 통화 설정 <span class="sec-note"></span></div>
                        <div class="grid grid-2 gap-3">
                            <div class="form-row" style="margin:0;">
                                <label class="form-label">🎤 음성통화 분당 요금 (50~1000)</label>
                                <input class="form-input opt-in" type="number" name="rate_per_minute" value="<%= profile.rate_per_minute %>" min="0" max="1000">
                            </div>
                            <div class="form-row opt-sec" data-needs="video_1on1" style="margin:0;">
                                <label class="form-label">📷 영상통화 분당 요금 <span class="text-faint" style="font-size:10px;">0 = 음성과 동일</span> <span class="sec-note"></span></label>
                                <input class="form-input opt-in" type="number" name="rate_cam" value="<%= profile.rate_cam %>" min="0" max="2000" step="10">
                            </div>
                        </div>
                        <div class="grid grid-2 gap-3" style="margin-top:12px;">
                            <div class="form-row" style="margin:0;">
                                <label class="form-label">무료 체험 시간 (초) — 0~120</label>
                                <input class="form-input opt-in" type="number" name="free_preview_sec" value="<%= profile.free_preview_sec %>" min="0" max="120" step="10">
                            </div>
                            <div class="form-row" style="margin:0;">
                                <label class="form-label">시간제 결제 단위 (분) — 1~60</label>
                                <input class="form-input opt-in" type="number" name="session_block_min" value="<%= profile.session_block_min %>" min="1" max="60">
                            </div>
                        </div>
                        <div class="mt-4" style="background:rgba(123,45,255,0.06);border-radius:var(--rad-sm);padding:10px 12px;">
                            <div class="mono text-faint" style="font-size:11px;">미리보기</div>
                            <p class="text-dim" style="font-size:13px;margin:4px 0 0;">
                                <strong id="pv-free" style="color:var(--c-pink);"><%= profile.free_preview_sec %></strong>초 무료 체험 후,
                                <strong id="pv-block" style="color:var(--c-pink);"><%= profile.session_block_min %></strong>분에
                                <strong id="pv-cost" style="color:var(--c-yellow);"><%= (profile.rate_per_minute * profile.session_block_min).toLocaleString() %></strong> Ruby 결제
                            </p>
                        </div>
                    </div>

                    <!-- ④ 방송 — 요금 설정이 없다는 것을 알려주는 안내 -->
                    <div class="card card-body mb-4 opt-sec" data-needs="multi" style="border-color:rgba(0,220,130,0.2);">
                        <div class="panel-title">④ 방송 (1:다수) <span class="sec-note"></span></div>
                        <p class="text-faint" style="font-size:12px;margin:0;">
                            방송은 <strong>입장 무료 + 후원</strong>이라 따로 정할 요금이 없습니다.
                            시청자 후원이 그대로 수익이 됩니다.
                        </p>
                    </div>

                    <!-- ⑤ 영상·구독 — 라이브 서비스와 무관하게 항상 사용 -->
                    <div class="card card-body mb-4" style="border-color:rgba(0,220,130,0.2);">
                        <div class="panel-title">⑤ 영상 멤버십 구독</div>
                        <p class="text-faint" style="font-size:11px;margin:0 0 10px;">
                            업로드한 영상에 적용됩니다. 1:1·방송을 하지 않아도 <strong>영상만 판매</strong>할 수 있습니다.
                        </p>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                            <div class="form-row" style="margin:0;">
                                <label class="form-label">구독 가격 (Ruby) — 0이면 구독 미제공</label>
                                <input class="form-input" type="number" name="sub_price" value="<%= profile.sub_price %>" min="0" max="100000" step="100">
                            </div>
                            <div class="form-row" style="margin:0;">
                                <label class="form-label">구독 기간 (일)</label>
                                <input class="form-input" type="number" name="sub_days" value="<%= profile.sub_days %>" min="1" max="365">
                            </div>
                        </div>
                        <p class="text-faint mt-2" style="font-size:11px;">
                            ⚠ 구독가가 <strong>0</strong>이면 가격을 안 매긴 영상(= 구독 전용)은
                            <strong>아무도 볼 수 없습니다.</strong> 구독가를 정하거나
                            <a href="/bj-studio/videos">내 영상</a>에서 개별구매 가격을 매기세요.
                        </p>
                        <label class="svc-item" style="display:flex;margin-top:12px;">
                            <input type="checkbox" name="show_sub_videos" value="1" <%= profile.show_sub_videos ? 'checked' : '' %>>
                            <div><strong>🔓 구독전용 영상 노출</strong><span>전체 영상 목록에 잠금 상태로 표시 (구독 유도)</span></div>
                        </label>
                    </div>

                    <!-- ⑥ 기기 제어 -->
                    <div class="form-row">
                        <label class="form-label">⑥ 기기 제어</label>
                        <div class="svc-grid">
                            <label class="svc-item">
                                <input type="checkbox" name="device_control" value="1" <%= profile.device_control ? 'checked' : '' %>>
                                <div><strong>🔌 기기 제어 제공</strong><span>내가 시청자 디바이스를 조작 (1:1·방송 공통)</span></div>
                            </label>
                        </div>
                    </div>

                    <button class="btn btn-primary">저장</button>
                </form>
            </div>

            <div class="card card-body mt-5" style="background: rgba(255, 184, 94, 0.05);">
                <div class="panel-title" style="color: var(--c-yellow);">💡 프로필 작성 팁</div>
                <ul class="text-dim" style="padding-left: 20px; line-height: 1.8; font-size: 13px;">
                    <li><strong>활동명</strong>: 사용자가 카드에서 처음 보는 이름. 짧고 기억에 남는 형태가 좋습니다.</li>
                    <li><strong>자기 소개</strong>: 1~2문장. 분위기·스타일을 함축적으로.</li>
                    <li><strong>요금</strong>: 1:1 신규는 100~150 Ruby/분 추천. 평점·후기가 쌓이면 인상.</li>
                    <li><strong>태그</strong>: 3개 이내 권장. 검색·필터에 사용됩니다.</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<style>
/* 제공하지 않는 서비스의 설정은 흐리게 + 입력 잠금 (값은 그대로 두어 다시 켜면 복원된다) */
.opt-sec.is-off { opacity: .45; }
.opt-sec.is-off .form-label { color: var(--tx-3); }
.opt-sec.is-off .opt-in { pointer-events: none; background: var(--bg-2); }
</style>

<script>
(function () {
    /* 공용 태그 클릭 → 태그 입력에 추가 */
    document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('.tag-pick');
        if (!b) return;
        var inp = document.getElementById('tag-input');
        if (!inp) return;
        var cur = inp.value.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
        var t = b.getAttribute('data-tag');
        if (cur.indexOf(t) === -1) { cur.push(t); inp.value = cur.join(','); }
    });

    var rateEl = document.querySelector('input[name="rate_per_minute"]');
    var checks = [].slice.call(document.querySelectorAll('.svc-check'));
    var secs   = [].slice.call(document.querySelectorAll('.opt-sec'));

    function picked() {
        var codes = [], audiences = {};
        checks.forEach(function (c) {
            if (!c.checked) return;
            codes.push(c.getAttribute('data-code'));
            audiences[c.getAttribute('data-audience')] = true;
        });
        return { codes: codes, audiences: audiences };
    }

    /* 섹션이 요구하는 조건이 충족됐는지 — 'audience' 값이거나 특정 서비스 코드 */
    function needsMet(needs, p) {
        if (needs === '1on1' || needs === 'multi') return !!p.audiences[needs];
        return p.codes.indexOf(needs) !== -1;
    }

    function sync() {
        var p = picked();
        secs.forEach(function (sec) {
            var off = !needsMet(sec.getAttribute('data-needs'), p);
            sec.classList.toggle('is-off', off);
            // readonly는 값을 그대로 전송한다 → 다시 켜면 이전 설정이 살아있다
            [].slice.call(sec.querySelectorAll('.opt-in')).forEach(function (i) { i.readOnly = off; });
            // 1:1을 제공할 때만 분당 요금을 브라우저에서도 필수/하한 검사한다
            if (sec.getAttribute('data-needs') === '1on1' && rateEl) {
                rateEl.required = !off;
                rateEl.min = off ? '0' : '50';
            }
            var note = sec.querySelector('.sec-note');
            if (note) note.textContent = off ? '— 제공하지 않아 사용되지 않습니다' : '';
        });
        upd();
    }

    /* 1:1 미리보기 */
    var rate  = document.querySelector('input[name="rate_per_minute"]');
    var free  = document.querySelector('input[name="free_preview_sec"]');
    var block = document.querySelector('input[name="session_block_min"]');
    var pvFree = document.getElementById('pv-free');
    var pvBlock = document.getElementById('pv-block');
    var pvCost = document.getElementById('pv-cost');
    function upd() {
        if (!pvFree || !pvBlock || !pvCost) return;
        pvFree.textContent = free.value || 0;
        pvBlock.textContent = block.value || 0;
        pvCost.textContent = ((parseInt(rate.value || 0, 10) * parseInt(block.value || 0, 10)) || 0).toLocaleString();
    }
    [rate, free, block].forEach(function (el) { el && el.addEventListener('input', upd); });
    checks.forEach(function (c) { c.addEventListener('change', sync); });
    sync();
})();
</script>
