<section class="container">
    <div class="mypage-grid">
        <%- include('_nav') %>

        <div>
            <div class="section-eyebrow">스트리머 STUDIO · 프로필</div>
            <h1 class="section-title">프로필 편집</h1>

            <% if (typeof error !== 'undefined' && error) { %><div class="flash-error"><%= error %></div><% } %>
            <% if (typeof ok !== 'undefined' && ok) { %>
                <div class="flash-error" style="background: rgba(0,220,130,0.1); border-color: rgba(0,220,130,0.3); color: #5EFFB0;">✓ <%= ok %></div>
            <% } %>

            <div class="card card-body">
                <form method="POST" action="/bj-studio/profile">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="form-row">
                        <label class="form-label">활동명 (스테이지명)</label>
                        <input class="form-input" type="text" name="stage_name" value="<%= profile.stage_name %>" required maxlength="30">
                    </div>
                    <div class="form-row">
                        <label class="form-label">자기 소개 (사용자가 카드에서 보는 텍스트)</label>
                        <textarea class="form-input" name="description" rows="3" maxlength="300"><%= profile.description %></textarea>
                    </div>
                    <div class="grid grid-2 gap-3">
                        <div class="form-row">
                            <label class="form-label">분당 요금 (Ruby) — 50~1000</label>
                            <input class="form-input" type="number" name="rate_per_minute" value="<%= profile.rate_per_minute %>" min="50" max="1000" required>
                        </div>
                        <div class="form-row">
                            <label class="form-label">태그 (콤마 구분)</label>
                            <input class="form-input" type="text" id="tag-input" name="tags" value="<%= profile.tags || '' %>" placeholder="예: 청순,성숙,코스프레" maxlength="100">
                            <% if (approvedTags && approvedTags.length) { %>
                                <div class="text-faint mt-2" style="font-size:11px;">공용 태그 — 눌러서 추가</div>
                                <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;">
                                    <% approvedTags.slice(0, 30).forEach(function (t) { %>
                                        <button type="button" class="tag tag-pick" data-tag="<%= t.name %>"
                                                style="cursor:pointer;border:1px solid var(--border-soft);background:none;">
                                            <%= t.name %><% if (t.use_count) { %> <span class="text-faint"><%= t.use_count %></span><% } %>
                                        </button>
                                    <% }) %>
                                </div>
                            <% } %>
                            <p class="text-faint mt-2" style="font-size:11px;">
                                <% if (tagMode === 'approval') { %>
                                    현재 <strong>승인제</strong> — 공용 태그는 바로 적용되고, 새 태그는 관리자 승인 후 공개됩니다.
                                <% } else if (tagMode === 'filter') { %>
                                    현재 <strong>자유입력(금지어 필터)</strong> — 금지어만 아니면 즉시 적용됩니다.
                                <% } else { %>
                                    현재 <strong>자유입력</strong> — 입력한 태그가 즉시 적용됩니다.
                                <% } %>
                                최대 10개.
                            </p>
                            <script>
                            document.addEventListener('click', function (e) {
                                var b = e.target.closest && e.target.closest('.tag-pick');
                                if (!b) return;
                                var inp = document.getElementById('tag-input');
                                var cur = inp.value.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
                                var t = b.getAttribute('data-tag');
                                if (cur.indexOf(t) === -1) { cur.push(t); inp.value = cur.join(','); }
                            });
                            </script>
                        </div>
                    </div>
                    <div class="grid grid-2 gap-3">
                        <div class="form-row">
                            <label class="form-label">무료 체험 시간 (초) — 0~120</label>
                            <input class="form-input" type="number" name="free_preview_sec" value="<%= profile.free_preview_sec %>" min="0" max="120" step="10" required>
                        </div>
                        <div class="form-row">
                            <label class="form-label">시간제 결제 단위 (분) — 1~60</label>
                            <input class="form-input" type="number" name="session_block_min" value="<%= profile.session_block_min %>" min="1" max="60" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <label class="form-label">서비스 태그 <span style="color:var(--c-red);">*필수</span> — 어떤 방식으로 진행하나요?</label>
                        <div class="svc-grid">
                            <% serviceTypes.forEach(function (s) { %>
                            <label class="svc-item">
                                <input type="checkbox" name="services" value="<%= s.code %>" <%= mySvc.includes(s.code) ? 'checked' : '' %>>
                                <div>
                                    <strong><%= s.icon %> <%= s.label %></strong>
                                    <span><%= s.desc %></span>
                                    <span style="color:<%= s.billing === 'donation' ? 'var(--c-green)' : 'var(--c-yellow)' %>;font-size:10px;">
                                        <%= s.billing === 'donation' ? '입장 무료 · 후원' : '분당 과금' %>
                                    </span>
                                </div>
                            </label>
                            <% }) %>
                        </div>
                        <p class="text-faint mt-2" style="font-size: 11px;">
                            체크한 서비스만 사용자에게 노출되고 방송 시작이 가능합니다. 최소 1개 필요.
                            <br>※ 의상·주제 같은 <strong>커스텀 태그</strong>는 아래 태그 항목에서 따로 지정합니다.
                        </p>
                    </div>

                    <div class="form-row">
                        <label class="form-label">추가 옵션</label>
                        <div class="svc-grid">
                            <label class="svc-item">
                                <input type="checkbox" name="device_control" value="1" <%= profile.device_control ? 'checked' : '' %>>
                                <div><strong>🔌 기기 제어 제공</strong><span>내가 시청자 디바이스를 조작</span></div>
                            </label>
                            <label class="svc-item">
                                <input type="checkbox" name="show_sub_videos" value="1" <%= profile.show_sub_videos ? 'checked' : '' %>>
                                <div><strong>🔓 구독전용 영상 노출</strong><span>전체 영상 목록에 잠금 상태로 표시 (구독 유도)</span></div>
                            </label>
                        </div>
                    </div>

                    <div class="card card-body mb-4" style="border-color: rgba(123,45,255,0.2);">
                        <div class="panel-title">보이스 제공 옵션 (능력별 요금)</div>
                        <p class="text-faint" style="font-size:11px; margin-bottom:10px;">통화는 항상 제공(위 '분당 요금'). 모니터링·캠은 0이면 미제공이며, 제공 시 사용자가 진입할 때 옵션으로 골라 그 요율로 결제합니다.</p>
                        <div class="form-row" style="margin:0 0 10px;">
                            <label class="form-label">🎬 모니터링 (사용자 영상 시청 + 스트리머 제어) 분당 — 0=미제공</label>
                            <input class="form-input" type="number" name="rate_with_video" value="<%= profile.rate_with_video %>" min="0" max="2000" step="10">
                        </div>
                        <div class="form-row" style="margin:0;">
                            <label class="form-label">📷 캠 (1:1 화상) 분당 — 0=미제공</label>
                            <input class="form-input" type="number" name="rate_cam" value="<%= profile.rate_cam %>" min="0" max="2000" step="10">
                        </div>
                    </div>

                    <div class="card card-body mb-4" style="border-color: rgba(0,220,130,0.2);">
                        <div class="panel-title">영상 멤버십 구독</div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                            <div class="form-row" style="margin:0;">
                                <label class="form-label">구독 가격 (Ruby) — 0이면 구독 미제공</label>
                                <input class="form-input" type="number" name="sub_price" value="<%= profile.sub_price %>" min="0" max="100000" step="100">
                            </div>
                            <div class="form-row" style="margin:0;">
                                <label class="form-label">구독 기간 (일)</label>
                                <input class="form-input" type="number" name="sub_days" value="<%= profile.sub_days %>" min="1" max="365">
                            </div>
                        </div>
                        <p class="text-faint mt-2" style="font-size:11px;">구독자는 기간 내 내 업로드 영상을 모두 무료로 시청합니다. 비구독자는 영상별 개별구매(가격은 <a href="/bj-studio/videos">내 영상</a>에서 설정) 가능.</p>
                    </div>

                    <div class="card card-body mb-4" style="background: rgba(123,45,255,0.06); border-color: rgba(123,45,255,0.2);">
                        <div class="mono text-faint" style="font-size: 12px;">미리보기</div>
                        <p class="text-dim mt-2" style="font-size: 13px;">
                            사용자는 <strong id="pv-free" style="color: var(--c-pink);"><%= profile.free_preview_sec %></strong>초 무료 체험 후,
                            <strong id="pv-block" style="color: var(--c-pink);"><%= profile.session_block_min %></strong>분에
                            <strong id="pv-cost" style="color: var(--c-yellow);"><%= (profile.rate_per_minute * profile.session_block_min).toLocaleString() %></strong> Ruby로 결제합니다.
                        </p>
                    </div>
                    <button class="btn btn-primary">저장</button>
                </form>
            </div>

            <div class="card card-body mt-5" style="background: rgba(255, 184, 94, 0.05);">
                <div class="panel-title" style="color: var(--c-yellow);">💡 프로필 작성 팁</div>
                <ul class="text-dim" style="padding-left: 20px; line-height: 1.8; font-size: 13px;">
                    <li><strong>활동명</strong>: 사용자가 카드에서 처음 보는 이름. 기억에 남는 짧은 형태가 좋습니다.</li>
                    <li><strong>자기 소개</strong>: 1~2문장. 분위기·스타일을 함축적으로.</li>
                    <li><strong>요금</strong>: 신규는 100~150 Ruby/분 추천. 평점·후기 쌓이면 인상.</li>
                    <li><strong>태그</strong>: 3개 이내 권장. 검색·필터에 사용됩니다.</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<script>
(function () {
    const rate  = document.querySelector('input[name="rate_per_minute"]');
    const free  = document.querySelector('input[name="free_preview_sec"]');
    const block = document.querySelector('input[name="session_block_min"]');
    const pvFree = document.getElementById('pv-free');
    const pvBlock = document.getElementById('pv-block');
    const pvCost = document.getElementById('pv-cost');
    function upd() {
        pvFree.textContent = free.value || 0;
        pvBlock.textContent = block.value || 0;
        pvCost.textContent = ((parseInt(rate.value||0) * parseInt(block.value||0)) || 0).toLocaleString();
    }
    [rate, free, block].forEach(el => el && el.addEventListener('input', upd));
})();
</script>
