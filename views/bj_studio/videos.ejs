<section class="container">
    <div class="mypage-grid">
        <%- include('_nav') %>

        <div>
            <div class="section-eyebrow">스트리머 STUDIO · 내 영상</div>
            <h1 class="section-title">내 영상 관리</h1>
            <p class="text-dim mb-5">업로드한 영상은 통화 중 사용자에게 틀어줄 수 있습니다. funscript를 함께 올리면 디바이스 자동 연동도 가능.</p>

            <% if (typeof error !== 'undefined' && error) { %><div class="flash-error"><%= error %></div><% } %>
            <% if (typeof ok !== 'undefined' && ok) { %>
                <div class="flash-error" style="background: rgba(0,220,130,0.1); border-color: rgba(0,220,130,0.3); color: #5EFFB0;">✓ <%= ok %></div>
            <% } %>

            <div class="card card-body mb-5">
                <div class="panel-title">영상 업로드</div>
                <form method="POST" action="/bj-studio/videos/upload" enctype="multipart/form-data">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="form-row">
                        <label class="form-label">📁 파일 한 번에 선택 (영상 + funscript)</label>
                        <input class="form-input" type="file" id="pick-all" multiple accept="video/*,.funscript,.json">
                        <p class="text-faint" style="font-size:11px;margin:6px 0 0;">
                            영상과 스크립트를 함께 고르면 자동으로 나눠 담고 제목도 채웁니다.
                            아래 칸에서 언제든 바꿀 수 있습니다.
                        </p>
                        <div id="pick-status" class="mono" style="font-size:11px;margin-top:6px;"></div>
                    </div>

                    <div class="form-row">
                        <label class="form-label">제목</label>
                        <input class="form-input" type="text" name="title" id="v-title" maxlength="80" required>
                    </div>
                    <div class="form-row">
                        <label class="form-label">영상 파일 (mp4/webm/mov, 최대 2GB)</label>
                        <input class="form-input" type="file" name="video" id="v-video" accept="video/*" required>
                    </div>
                    <div class="form-row">
                        <label class="form-label">funscript (선택 — 디바이스 자동 연동용)</label>
                        <input class="form-input" type="file" name="script" id="v-script" accept=".funscript,.json">
                    </div>
                    <div class="form-row">
                        <label class="form-label">썸네일</label>
                        <input class="form-input" type="file" name="thumb" id="v-thumb" accept=".jpg,.jpeg,.png">
                        <p class="text-faint" style="font-size:11px;margin:6px 0 0;">
                            영상을 고르면 <strong>자동으로 한 장 뽑아 채웁니다.</strong>
                            마음에 안 들면 직접 골라 바꾸세요.
                        </p>
                        <div id="thumb-preview" style="margin-top:8px;"></div>
                    </div>

                    <div class="form-row">
                        <label class="form-label">개별구매(PPV) 가격 (Ruby) — 0이면 구독 전용</label>
                        <input class="form-input" type="number" name="price" value="0" min="0" max="100000" step="100">
                        <p class="text-faint mt-2" style="font-size:11px;">구독자는 무료 시청. 비구독자는 이 가격으로 개별 구매(영구 시청).</p>
                    </div>
                    <button class="btn btn-primary">업로드</button>
                    <p class="text-faint mt-3" style="font-size:11px;">⚠ 본인 또는 적법한 권리가 있는 영상만 업로드하세요. 심의·저작권 위반 시 삭제·제재됩니다.</p>
                </form>
            </div>

            <div class="card card-body">
                <div class="panel-title">업로드한 영상 (<%= videos.length %>)</div>
                <% if (!videos.length) { %>
                    <div class="text-faint text-center" style="padding: 40px;">아직 업로드한 영상이 없습니다.</div>
                <% } else { %>
                    <table class="tx-table">
                        <thead><tr><th>제목</th><th>스크립트</th><th>PPV 가격</th><th>태그</th><th>업로드일</th><th></th></tr></thead>
                        <tbody>
                            <% videos.forEach(v => { %>
                                <tr>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:8px;">
                                            <% if (v.thumb_key) { %>
                                                <img src="<%= v.thumb_key %>" alt="" onerror="this.style.display='none'"
                                                     style="width:64px;aspect-ratio:16/9;object-fit:cover;border-radius:4px;flex:none;">
                                            <% } else { %>
                                                <span style="width:64px;aspect-ratio:16/9;background:var(--bg-3);border-radius:4px;flex:none;"></span>
                                            <% } %>
                                            <a href="/bj/vid/<%= v.id %>" target="_blank"><%= v.title %></a>
                                        </div>
                                    </td>
                                    <td><%= v.script_path ? '✓ 연동' : '—' %></td>
                                    <td>
                                        <form method="POST" action="/bj-studio/videos/<%= v.id %>/price" style="margin:0;display:flex;gap:4px;align-items:center;">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input class="form-input" type="number" name="price" value="<%= v.price %>" min="0" max="100000" step="100" style="width:90px;padding:4px 8px;">
                                            <button class="btn btn-sm btn-ghost">변경</button>
                                        </form>
                                    </td>
                                    <td>
                                        <form method="POST" action="/bj-studio/videos/<%= v.id %>/tags" style="margin:0;display:flex;gap:4px;align-items:center;">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input class="form-input vtag-input" type="text" name="tags" value="<%= v.tagStr %>"
                                                   placeholder="태그(쉼표)" maxlength="120" style="width:170px;padding:4px 8px;font-size:12px;">
                                            <button class="btn btn-sm btn-ghost">저장</button>
                                        </form>
                                    </td>
                                    <td class="mono text-faint" style="font-size:11px;"><%= v.created_at %></td>
                                    <td>
                                        <form method="POST" action="/bj-studio/videos/<%= v.id %>/delete" style="margin:0;" onsubmit="return confirm('삭제할까요?');">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button class="btn btn-sm btn-ghost" style="color:#FFB8B8;">삭제</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>
    </div>
</section>

<% if (approvedTags && approvedTags.length) { %>
<div class="card card-body mt-4">
    <div class="text-faint" style="font-size:11px;margin-bottom:8px;">공용 태그 — 클릭하면 마지막으로 클릭한 영상의 태그 칸에 추가됩니다</div>
    <div style="display:flex;flex-wrap:wrap;gap:6px;">
        <% approvedTags.forEach(function (t) { %>
            <button type="button" class="tag vtag-pick" data-tag="<%= t.name %>"
                    style="cursor:pointer;border:1px solid var(--border-soft);background:none;"><%= t.name %></button>
        <% }) %>
    </div>
</div>
<% } %>

<script>
// 마지막으로 포커스한 태그 입력칸을 기억했다가 공용 태그 클릭 시 거기에 추가
(function () {
    var last = null;
    document.querySelectorAll('.vtag-input').forEach(function (i) {
        i.addEventListener('focus', function () { last = i; });
    });
    document.querySelectorAll('.vtag-pick').forEach(function (b) {
        b.addEventListener('click', function () {
            var t = last || document.querySelector('.vtag-input');
            if (!t) return;
            var cur = t.value.split(',').map(function (x) { return x.trim(); }).filter(Boolean);
            var name = b.getAttribute('data-tag');
            if (cur.indexOf(name) === -1) { cur.push(name); t.value = cur.join(','); }
            t.focus();
        });
    });
})();
</script>

<script>
/* 업로드 편의 — 파일을 한 번에 고르면 영상/스크립트로 나눠 담고 제목을 채운다.
 * 브라우저 보안상 파일 입력에 디스크 경로로 값을 넣을 수는 없으므로,
 * 사용자가 고른 File 객체를 DataTransfer로 각 입력에 옮겨 담는 방식을 쓴다.
 * (DataTransfer 미지원 브라우저에서는 제목만 채우고 안내한다) */
(function () {
    var all    = document.getElementById('pick-all');
    var video  = document.getElementById('v-video');
    var script = document.getElementById('v-script');
    var title  = document.getElementById('v-title');
    var status = document.getElementById('pick-status');
    if (!all || !video || !script || !title) return;

    var SCRIPT_RE = /\.(funscript|json)$/i;
    // 다축 보조 스크립트 — 메인(.funscript)과 구분한다
    var AXIS_RE   = /\.(roll|twist|pitch|surge|sway)\.(funscript|json)$/i;

    function baseName(name) { return String(name).replace(/\.[^.]+$/, ''); }
    function titleFrom(name) {
        return baseName(name).replace(/[_]+/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 80);
    }
    function setFile(input, file) {
        try {
            var dt = new DataTransfer();
            dt.items.add(file);
            input.files = dt.files;
            return true;
        } catch (e) { return false; }
    }
    function say(html, color) {
        if (!status) return;
        status.innerHTML = html;
        status.style.color = color || 'var(--tx-3)';
    }

    all.addEventListener('change', function () {
        var files = Array.prototype.slice.call(all.files || []);
        if (!files.length) { say(''); return; }

        var vid = null, main = null, axes = [];
        files.forEach(function (f) {
            if (SCRIPT_RE.test(f.name)) { AXIS_RE.test(f.name) ? axes.push(f) : (main = main || f); }
            else if (!vid) { vid = f; }
        });
        // 메인 스크립트가 없고 축 스크립트만 있으면 그거라도 쓴다
        if (!main && axes.length) { main = axes.shift(); }

        var msgs = [], warn = false;

        if (vid) {
            if (!setFile(video, vid)) { warn = true; msgs.push('영상 자동 담기 실패 — 아래에서 직접 선택'); }
            else { msgs.push('영상: ' + vid.name); makeThumb(vid); }   // .files 대입은 change를 안 띄운다
            if (!title.value.trim()) title.value = titleFrom(vid.name);
        } else {
            warn = true; msgs.push('영상 파일이 없습니다');
        }

        if (main) {
            if (!setFile(script, main)) { warn = true; msgs.push('스크립트 자동 담기 실패 — 아래에서 직접 선택'); }
            else {
                var match = vid && baseName(main.name).toLowerCase().indexOf(baseName(vid.name).toLowerCase()) === 0;
                msgs.push('스크립트: ' + main.name + (vid ? (match ? ' (이름 일치 ✓)' : ' (이름 다름 — 확인)') : ''));
                if (vid && !match) warn = true;
            }
        } else {
            msgs.push('스크립트 없음 (선택)');
        }

        if (axes.length) {
            warn = true;
            msgs.push('⚠ 다축 스크립트 ' + axes.length + '개는 아직 함께 올릴 수 없습니다 (' +
                      axes.map(function (f) { return f.name; }).join(', ') + ')');
        }

        say(msgs.join('<br>'), warn ? 'var(--c-yellow)' : 'var(--c-green)');
    });

    // 영상만 따로 고른 경우에도 제목을 채운다
    video.addEventListener('change', function () {
        var f = video.files && video.files[0];
        if (f && !title.value.trim()) title.value = titleFrom(f.name);
        makeThumb(f);
    });

    /* 썸네일 자동 생성 — 브라우저에서 영상 한 프레임을 캔버스로 떠서 JPEG로 만든다.
     * 서버(폰)에는 ffmpeg이 없고, 있어도 트랜스코딩은 CPU·발열 때문에 부담이다.
     * 사용자가 직접 고른 썸네일이 있으면 덮어쓰지 않는다. */
    var thumbInput = document.getElementById('v-thumb');
    var thumbPrev  = document.getElementById('thumb-preview');
    var autoThumb  = false;      // 자동 생성분인지 (사용자가 고른 건 건드리지 않는다)

    if (thumbInput) {
        thumbInput.addEventListener('change', function () {
            if (thumbInput.files && thumbInput.files.length) {
                autoThumb = false;
                showPrev(URL.createObjectURL(thumbInput.files[0]), '직접 선택함');
            }
        });
    }
    function showPrev(url, note) {
        if (!thumbPrev) return;
        thumbPrev.innerHTML = '<img src="' + url + '" style="width:160px;aspect-ratio:16/9;object-fit:cover;'
            + 'border-radius:var(--rad-sm);border:1px solid var(--border-soft);">'
            + '<div class="text-faint" style="font-size:11px;margin-top:4px;">' + note + '</div>';
    }
    function note(msg) { if (thumbPrev) thumbPrev.innerHTML = '<div class="text-faint" style="font-size:11px;">' + msg + '</div>'; }

    function makeThumb(file) {
        if (!file || !thumbInput) return;
        if (thumbInput.files && thumbInput.files.length && !autoThumb) return;   // 사용자가 고른 것 보존
        if (!window.URL || !document.createElement('canvas').getContext) return;

        note('썸네일 만드는 중…');
        var url = URL.createObjectURL(file);
        var vid = document.createElement('video');
        vid.preload = 'metadata'; vid.muted = true; vid.playsInline = true;

        var done = false;
        function fail(msg) {
            if (done) return; done = true;
            URL.revokeObjectURL(url);
            note(msg || '썸네일 자동 생성 실패 — 직접 골라주세요 (없어도 업로드는 됩니다)');
        }
        setTimeout(function () { fail(); }, 15000);   // 코덱 미지원 등으로 영영 안 끝나는 경우

        vid.onerror = function () { fail('이 브라우저가 영상 형식을 못 읽습니다 — 썸네일을 직접 골라주세요'); };
        vid.onloadedmetadata = function () {
            // 앞부분은 검은 화면인 경우가 많다 → 10% 지점(최대 30초)
            var t = Math.min(30, Math.max(1, (vid.duration || 10) * 0.1));
            vid.currentTime = isFinite(t) ? t : 1;
        };
        vid.onseeked = function () {
            if (done) return;
            try {
                var w = 480, h = Math.round(w * (vid.videoHeight / vid.videoWidth)) || 270;
                var c = document.createElement('canvas'); c.width = w; c.height = h;
                c.getContext('2d').drawImage(vid, 0, 0, w, h);
                c.toBlob(function (blob) {
                    if (done) return;
                    if (!blob) return fail();
                    var f = new File([blob], 'thumb.jpg', { type: 'image/jpeg' });
                    try {
                        var dt = new DataTransfer(); dt.items.add(f);
                        thumbInput.files = dt.files;
                        autoThumb = true;
                        done = true;
                        URL.revokeObjectURL(url);
                        showPrev(c.toDataURL('image/jpeg', 0.8), '자동 생성됨 (' + w + '×' + h + ')');
                    } catch (e) { fail(); }
                }, 'image/jpeg', 0.8);
            } catch (e) { fail(); }
        };
        vid.src = url;
    }
})();
</script>
