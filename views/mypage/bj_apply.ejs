<section class="container">
    <div class="mypage-grid">
        <%- include('_layout_helper') %>

        <div>
            <h1 class="section-title">스트리머 신청</h1>

            <% if (typeof error !== 'undefined' && error) { %><div class="flash-error"><%= error %></div><% } %>

            <% if (req.query && req.query.submitted) { %>
                <div class="flash-error" style="background: rgba(0,220,130,0.1); border-color: rgba(0,220,130,0.3); color: #5EFFB0;">
                    ✓ 신청서가 접수되었습니다. 관리자 심사 후 결과 알림드립니다.
                </div>
            <% } %>

            <% if (existing) { %>
                <div class="card card-body mb-4">
                    <div class="panel-title">최근 신청</div>
                    <div class="mono text-faint" style="font-size:13px; display:grid; grid-template-columns:100px 1fr; gap:6px 12px;">
                        <span>활동명</span><span style="color: white;"><%= existing.stage_name %></span>
                        <span>상태</span>
                        <span style="color: <%= existing.status === 'approved' ? 'var(--c-green)' : existing.status === 'rejected' ? 'var(--c-pink)' : 'var(--c-yellow)' %>;">
                            <%= existing.status === 'approved' ? '✓ 승인됨'
                              : existing.status === 'rejected' ? '✗ 거절됨'
                              : '⏳ 심사 중' %>
                        </span>
                        <span>접수일</span><span><%= existing.created_at %></span>
                    </div>
                </div>
            <% } %>

            <% if (!existing || existing.status === 'rejected') { %>
                <div class="card card-body">
                    <div class="panel-title">신청서 작성</div>
                    <form method="POST" action="/mypage/bj-apply">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="form-row">
                            <label class="form-label">활동명 (스테이지명)</label>
                            <input class="form-input" type="text" name="stage_name" required maxlength="30">
                        </div>
                        <div class="form-row">
                            <label class="form-label">자기 소개</label>
                            <textarea class="form-input" name="description" rows="3" maxlength="200"></textarea>
                        </div>
                        <div class="form-row">
                            <label class="form-label">관리자에게 한마디 (선택)</label>
                            <textarea class="form-input" name="intro_message" rows="2" maxlength="200"></textarea>
                        </div>
                        <p class="text-faint mb-4" style="font-size:12px;">
                            ⚠ 신청 시 본인 인증과 19+ 확인, 관리자 면접이 추가로 필요합니다. (데모 — 자동 승인 가능)
                        </p>
                        <button class="btn btn-primary">신청서 제출</button>
                    </form>
                </div>
            <% } %>
        </div>
    </div>
</section>
